---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import Icon from '@/components/common/Icon.astro';
import { clientsData } from '@/data/clients.data';

const breadcrumbs = [{ name: '客户端生态中心', url: '/clients' }];
---

<BaseLayout
  title="主流代理客户端下载与配置中心 (Clash Verge / Shadowrocket / sing-box)"
  description="全平台跨设备代理客户端导航：Windows, macOS, iOS, Android, Linux 官方安全下载地址、TUN 虚拟网卡配置与核心分流实战教程。"
  breadcrumbs={breadcrumbs}
>
  <Breadcrumb items={breadcrumbs} />

  <div class="mb-8">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tech-cyan/10 border border-tech-cyan/30 text-tech-cyan text-xs font-semibold mb-3">
      <Icon name="cpu" class="w-3.5 h-3.5" />
      <span>全平台支持 · 官方安全渠道</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">代理客户端知识与生态中心</h1>
    <p class="text-sm text-slate-400 mt-2 max-w-3xl">
      严选活跃开源、支持现代抗封锁协议（Mihomo / sing-box / Xray 内核）的高性能客户端。杜绝第三方改版与投毒风险。
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
    {clientsData.map((client) => (
      <div class="glass-card-hover rounded-xl p-6 border border-slate-800/80 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-lg font-bold text-white">{client.name}</h2>
            {client.isRecommended && (
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-tech-emerald/20 text-tech-emerald border border-tech-emerald/30">
                推荐首选
              </span>
            )}
          </div>
          <p class="text-xs text-slate-300 mb-4">{client.tagline}</p>

          <div class="p-3 rounded-lg bg-slate-950/80 border border-slate-900 mb-4 text-xs space-y-1.5">
            <div class="flex justify-between">
              <span class="text-slate-500">底层内核:</span>
              <span class="text-slate-300 font-mono">{client.coreEngine}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">支持平台:</span>
              <span class="text-slate-300">{client.platforms.join(', ')}</span>
            </div>
          </div>

          <ul class="space-y-1 text-xs text-slate-400 mb-4">
            {client.pros.slice(0, 2).map((pro) => (
              <li class="flex items-center gap-1.5">
                <span class="text-tech-cyan">✓</span>
                <span class="line-clamp-1">{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-2">
          <a
            href={client.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-colors"
          >
            GitHub
          </a>
          <a
            href={`/client/${client.slug}`}
            class="px-4 py-1.5 rounded-lg text-xs font-bold bg-tech-cyan/20 hover:bg-tech-cyan/30 text-tech-cyan border border-tech-cyan/40 transition-colors flex items-center gap-1"
          >
            <span>配置教程</span>
            <Icon name="arrow-right" class="w-3 h-3" />
          </a>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
