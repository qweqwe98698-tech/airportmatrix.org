---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import Icon from '@/components/common/Icon.astro';
import NextBestPage from '@/components/article/NextBestPage.astro';
import { providersData } from '@/data/providers.data';

const breadcrumbs = [{ name: '4K/8K 流媒体解锁', url: '/streaming' }];
const streamingProviders = providersData.filter((p) => p.streamingSupport.netflix);

const nextPages = [
  {
    title: '专线机场综合排行榜',
    href: '/providers',
    desc: '按 Netflix / Disney+ 解锁与带宽吞吐量进行筛选。',
    type: '节点推荐',
  },
  {
    title: 'Hysteria 2 协议极速下载与高码率视频实战',
    href: '/protocol/hysteria2',
    desc: '了解基于 UDP 的 Hysteria 2 协议如何在弱网下保证 8K 视频秒开。',
    type: '协议百科',
  },
];
---

<BaseLayout
  title="Netflix / YouTube Premium / Disney+ 4K/8K 流媒体解锁机场推荐"
  description="深度解析流媒体版权跨区解锁机制：原生双向 IP、Netflix 非自制剧解锁、Disney+ 4K HDR 支持与大带宽抗拥堵机场矩阵。"
  breadcrumbs={breadcrumbs}
>
  <Breadcrumb items={breadcrumbs} />

  <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 border border-slate-800 mb-8">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tech-cyan/10 border border-tech-cyan/30 text-tech-cyan text-xs font-semibold mb-3">
      <Icon name="tv" class="w-3.5 h-3.5" />
      <span>超高清音视频 · 原生双向解锁</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">4K / 8K 流媒体解锁矩阵</h1>
    <p class="text-sm sm:text-base text-slate-300 mt-2 max-w-3xl leading-relaxed">
      Netflix 仅能看自制剧？YouTube Premium 无法开通家庭组？Disney+ 提示 Error 73？本文为您解析流媒体平台对机房 IP 的检测机制，并推荐具备原生 DNS 解锁的高清专线服务。
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
      <div class="text-xs font-bold text-rose-400 uppercase">Netflix 奈飞</div>
      <h2 class="text-base font-bold text-white">非自制剧全量解锁</h2>
      <p class="text-xs text-slate-400 leading-relaxed">
        严格测试港、台、日、美、韩、新主流大区，保证绝命毒师、进击的巨人等第三方版权剧集完整展示。
      </p>
    </div>

    <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
      <div class="text-xs font-bold text-cyan-400 uppercase">Disney+ 迪士尼</div>
      <h2 class="text-base font-bold text-white">Star 专区与 IMAX Enhanced</h2>
      <p class="text-xs text-slate-400 leading-relaxed">
        支持港台 Star 华语影视专区与美区 IMAX Enhanced 高规格杜比视界音频串流。
      </p>
    </div>

    <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
      <div class="text-xs font-bold text-amber-400 uppercase">YouTube 4K/8K</div>
      <h2 class="text-base font-bold text-white">高峰期 100Mbps+ 稳定吞吐</h2>
      <p class="text-xs text-slate-400 leading-relaxed">
        专线保障晚高峰 Connection Speed &gt; 150,000 Kbps，拖拽进度条 0 缓冲秒开。
      </p>
    </div>
  </div>

  <!-- Streaming Providers -->
  <div class="mb-12">
    <h2 class="text-xl font-bold text-white mb-4">4K 流媒体高可用专线机场清单</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {streamingProviders.map((provider) => (
        <div class="glass-card-hover rounded-xl p-5 border border-slate-800/80 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-base font-bold text-white">{provider.name}</h3>
              <span class="text-xs font-mono font-bold text-tech-emerald">¥{provider.pricing.minMonthly}/月起</span>
            </div>
            <p class="text-xs text-slate-400 mb-3">{provider.tagline}</p>
            <div class="p-3 rounded-lg bg-slate-950/80 border border-slate-900 text-xs text-slate-300 mb-4">
              <span class="text-tech-cyan font-semibold">流媒体能力：</span>
              <span class="text-slate-400">{provider.streamingSupport.notes}</span>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between">
            <a href={`/provider/${provider.slug}`} class="text-xs font-semibold text-slate-300 hover:text-white">
              评测详情
            </a>
            <a
              href={provider.affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="px-3 py-1.5 rounded-lg text-xs font-bold bg-tech-cyan text-slate-950 hover:bg-cyan-400"
            >
              官网直达
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <NextBestPage nextPages={nextPages} />
</BaseLayout>
