---
import { providersData } from '@/data/providers.data';

export function getStaticPaths() {
  return providersData.map((provider) => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>正在安全直达 {provider.name} 官方网站 - AirportMatrix 安全中转</title>
    <meta name="robots" content="noindex, nofollow" />
    <!-- Instant Fallback Redirect -->
    <meta http-equiv="refresh" content={`2;url=${provider.affiliateUrl}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      body {
        margin: 0;
        background-color: #05070b;
        color: #e2e8f0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        overflow: hidden;
      }
      .card {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(51, 65, 85, 0.8);
        border-radius: 20px;
        padding: 36px 32px;
        max-width: 440px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 30px rgba(16, 185, 129, 0.15);
        backdrop-filter: blur(16px);
      }
      .spinner {
        width: 44px;
        height: 44px;
        border: 3px solid rgba(16, 185, 129, 0.15);
        border-top-color: #10b981;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 20px;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #10b981, #06b6d4);
        color: #05070b;
        font-weight: 800;
        font-size: 14px;
        padding: 12px 24px;
        border-radius: 12px;
        text-decoration: none;
        margin-top: 20px;
        transition: transform 0.2s, opacity 0.2s;
      }
      .btn:hover {
        transform: scale(1.02);
        opacity: 0.95;
      }
      .coupon {
        display: inline-block;
        background: rgba(16, 185, 129, 0.1);
        border: 1px dashed #10b981;
        color: #10b981;
        padding: 6px 14px;
        border-radius: 8px;
        font-family: monospace;
        font-weight: bold;
        margin-top: 14px;
        font-size: 13px;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="spinner"></div>
      <h2 style="margin: 0 0 8px; font-size: 20px; color: #fff;">正在直达 {provider.name}</h2>
      <p style="margin: 0; font-size: 13px; color: #94a3b8;">已为您开启防屏蔽加密通道，正在跳转官方注册页...</p>

      {provider.couponCode && (
        <div>
          <div class="coupon">
            <span>专属优惠码：</span>
            <span id="cp-code">{provider.couponCode}</span>
          </div>
          <p style="font-size: 11px; color: #64748b; margin-top: 6px;">
            {provider.discountInfo || '结账时粘贴立享折扣'}
          </p>
        </div>
      )}

      <div>
        <a id="direct-btn" href={provider.affiliateUrl} class="btn">
          立即前往官方网站 →
        </a>
      </div>
      <p style="font-size: 11px; color: #475569; margin-top: 18px;">
        AirportMatrix 认证服务商 · 官方直连链路
      </p>
    </div>

    <script define:vars={{ url: provider.affiliateUrl, code: provider.couponCode }}>
      // Auto copy coupon code if available
      if (code && navigator.clipboard) {
        navigator.clipboard.writeText(code).catch(() => {});
      }
      // Redirect after 1.2s
      setTimeout(() => {
        window.location.href = url;
      }, 1200);
    </script>
  </body>
</html>
