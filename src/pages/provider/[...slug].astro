---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import RiskBadge from '@/components/provider/RiskBadge.astro';
import Icon from '@/components/common/Icon.astro';
import NextBestPage from '@/components/article/NextBestPage.astro';
import FaqSection from '@/components/article/FaqSection.astro';
import { providersData } from '@/data/providers.data';
import { articlesData } from '@/data/articles.data';
import { comparisonsData } from '@/data/comparisons.data';

export function getStaticPaths() {
  return providersData.map((provider) => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props;

const isProtectedTopRank = provider.slug === 'u1s1';
const reviewArticle = articlesData.find(
  (a) => a.slug === `${provider.slug}-in-depth-review-2026`
);
const relatedComparison = comparisonsData.find(
  (c) => c.itemA === provider.slug || c.itemB === provider.slug
);

const hasPrice = provider.pricing.minMonthly > 0;
const priceTagText = hasPrice ? `¥${provider.pricing.minMonthly}/月起` : '价格待核实';
const nodeTagText = provider.nodeCount > 0 ? `${provider.nodeCount}+ 节点` : '节点规模待核实';

const unlockBadge = (status: 'supported' | 'node-dependent' | 'failed' | 'untested') => {
  switch (status) {
    case 'supported':
      return { text: '支持 / 全绿', cls: 'bg-emerald-950/70 text-emerald-300 border-emerald-500/30' };
    case 'node-dependent':
      return { text: '视节点而定', cls: 'bg-amber-950/70 text-amber-300 border-amber-500/30' };
    case 'failed':
      return { text: '不支持', cls: 'bg-rose-950/70 text-rose-300 border-rose-500/30' };
    default:
      return { text: '待核实', cls: 'bg-slate-900 text-slate-400 border-slate-700' };
  }
};

const subscriptionModeMap: Record<string, string> = {
  both: '支持通用订阅导入 + 自研/专属客户端',
  subscription: '支持 Clash / Shadowrocket 等通用订阅导入',
  'client-only': '仅支持官方专属客户端登录使用（不提供 Clash/通用订阅链接）',
  unknown: '客户端与订阅模式待进一步核实',
};
const subscriptionModeText = subscriptionModeMap[provider.subscriptionMode || 'unknown'];

const pageTitle = isProtectedTopRank
  ? `${provider.name} 2026 深度评测、节点测速与套餐分析`
  : `${provider.name} 2026 机场测评：${priceTagText}${provider.couponCode ? `（优惠码 ${provider.couponCode}）` : ''} · 节点与套餐解析`;

const pageDescription = isProtectedTopRank
  ? `${provider.name} 真实评测：始于 ${provider.establishedYear} 年，综合评分 ${provider.score.overall}/10。涵盖专线类型、协议支持、AI/流媒体解锁与退款政策全方位解析。`
  : `${provider.name} 2026 最新测评与档案：始于 ${provider.establishedYear} 年，${provider.routes.map((r) => r.toUpperCase()).join('+')} 专线，${nodeTagText}，${provider.pricing.billingPeriod}${provider.couponCode ? `，专属优惠码 ${provider.couponCode}` : ''}。查看 Clash 兼容度、AI/4K 解锁、测速与待核验信息说明。`;

const providerFaqs = [
  {
    question: `${provider.name} 套餐多少钱？性价比如何？`,
    answer: hasPrice
      ? `${provider.name} 当前起步计费参考为 ${provider.pricing.billingPeriod}（单月折算低至 ¥${provider.pricing.minMonthly}/月），流量档位覆盖 ${provider.bandwidthLimit}。${provider.couponCode ? `下单使用优惠码【${provider.couponCode}】可享受对应折扣（${provider.discountInfo || '以官网结算为准'}）。` : '具体套餐详情与限时活动以官网实时页面为准。'}`
      : `${provider.name} 当前为历史/后置档案，公开价格与当前在售套餐尚待核实。建议结合页面标注的核验缺口确认最新可用性。`,
  },
  {
    question: `${provider.name} 支持 Clash Verge 和小火箭等通用订阅吗？`,
    answer:
      provider.subscriptionMode === 'client-only'
        ? `不支持第三方通用订阅链接。根据资料记录，${provider.name} 仅提供官方专属客户端登录使用（${provider.clients.join('、')}），购买前请确认您的设备系统匹配官方客户端支持范围。`
        : `根据当前核验资料，${provider.name} 支持 ${provider.clients.join('、')} 等客户端连接，支持 ${provider.protocols.map((p) => p.toUpperCase()).join(' / ')} 协议${provider.subscriptionMode === 'both' ? '并兼有自研客户端与通用订阅' : ''}。`,
  },
  {
    question: `${provider.name} 适合用来访问 ChatGPT 或看 4K 流媒体吗？`,
    answer: `AI 支持：${provider.aiSupport.notes} 流媒体解锁：${provider.streamingSupport.notes}`,
  },
];

const breadcrumbs = [
  { name: '机场测评排行榜', url: '/providers' },
  { name: `${provider.name} 深度评测与档案`, url: `/provider/${provider.slug}` },
];

const nextPages = [
  ...(reviewArticle
    ? [
        {
          title: reviewArticle.title,
          href: `/articles/${reviewArticle.slug}`,
          desc: reviewArticle.description,
          type: '深度实测全文',
        },
      ]
    : []),
  ...(relatedComparison
    ? [
        {
          title: relatedComparison.name,
          href: `/compare/${relatedComparison.slug}`,
          desc: relatedComparison.tagline,
          type: '横向对比',
        },
      ]
    : []),
  {
    title: '2026 高性价比机场推荐排行榜',
    href: '/category/cost-effective',
    desc: '对比同价位高性价比机场的月付成本、节点质量与稳定性。',
    type: '性价比专题',
  },
  {
    title: 'Clash Verge Rev 完整配置教程',
    href: '/client/clash-verge',
    desc: '了解如何将该机场的一键订阅导入 Clash Verge Rev 并开启 TUN 模式。',
    type: '客户端指南',
  },
].slice(0, 4);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  schemaType="Product"
  productData={{
    name: provider.name,
    ratingValue: provider.score.overall,
    price: provider.pricing.minMonthly,
    priceCurrency: 'CNY',
  }}
  faqData={providerFaqs}
>
  <Breadcrumb items={breadcrumbs} />

  <!-- Provider Hero Header -->
  <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 border border-slate-800 mb-8 relative overflow-hidden">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <div class="flex items-center gap-2.5 flex-wrap mb-2">
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white">{provider.name}</h1>
          <RiskBadge level={provider.riskLevel} showDesc />
        </div>
        <p class="text-sm sm:text-base text-slate-300 max-w-2xl">{provider.tagline}</p>
        <div class="flex items-center gap-4 mt-4 text-xs text-slate-400 font-mono flex-wrap">
          <span>运营年限: {provider.establishedYear} 年至今</span>
          <span>·</span>
          <span>节点规模: {nodeTagText}</span>
          <span>·</span>
          <span>连接方式: {provider.subscriptionMode === 'client-only' ? '仅专属客户端' : provider.subscriptionMode === 'both' ? '通用订阅 + 自研客户端' : provider.subscriptionMode === 'subscription' ? '通用订阅' : '待核实'}</span>
          <span>·</span>
          <span>核验时间: {provider.lastVerified}</span>
        </div>
      </div>

      <!-- Score & CTA -->
      <div class="flex flex-col sm:flex-row md:flex-col items-start sm:items-center md:items-end gap-3 flex-shrink-0">
        <div class="flex items-center gap-2 p-2 rounded-xl bg-slate-950 border border-slate-800">
          <div class="text-3xl font-extrabold text-tech-emerald font-mono">{provider.score.overall.toFixed(1)}</div>
          <div class="text-[10px] text-slate-400 leading-tight">
            <div>综合评分</div>
            <div class="text-slate-500">满分 10.0</div>
          </div>
        </div>
        {provider.affiliateUrl ? (
          <div class="flex flex-col items-start md:items-end gap-1">
            <a
              href={provider.affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-xs transition-all shadow-glow flex items-center gap-1.5"
            >
              <span>前往官方网站</span>
              <Icon name="external-link" class="w-3.5 h-3.5" />
            </a>
            <span class="text-[10px] text-slate-500">含推广链接，注册不影响用户价格</span>
          </div>
        ) : (
          <div class="px-4 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-400 font-mono">
            官网入口待核实（档案参考）
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Coupon Code Box (if applicable) -->
  {provider.couponCode && (
    <div class="p-4 sm:p-5 rounded-xl bg-gradient-to-r from-emerald-950/40 via-slate-900 to-slate-950 border border-emerald-500/40 shadow-glow mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-lg bg-emerald-500/20 text-emerald-400">
          <Icon name="sparkles" class="w-5 h-5" />
        </div>
        <div>
          <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider">优惠信息与规则说明</div>
          <div class="text-sm font-semibold text-slate-200 mt-0.5">{provider.discountInfo}</div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <div class="px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs font-mono font-bold text-emerald-400 flex items-center gap-1.5">
          <span class="text-slate-500 font-normal">优惠码:</span>
          <span>{provider.couponCode}</span>
        </div>
        {provider.affiliateUrl && (
          <a
            href={provider.affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-tech-emerald text-slate-950 hover:bg-emerald-400 transition-colors"
          >
            前往领券
          </a>
        )}
      </div>
    </div>
  )}

  <!-- Radar & Key Metrics Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
      <div class="text-xs text-slate-400 mb-1">链路稳定性</div>
      <div class="text-xl font-bold font-mono text-emerald-400">{provider.score.stability * 10}%</div>
      <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
        <div class="bg-emerald-500 h-full rounded-full" style={`width: ${provider.score.stability * 10}%`}></div>
      </div>
    </div>

    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
      <div class="text-xs text-slate-400 mb-1">高峰期吞吐</div>
      <div class="text-xl font-bold font-mono text-cyan-400">{provider.score.speed * 10}%</div>
      <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
        <div class="bg-cyan-500 h-full rounded-full" style={`width: ${provider.score.speed * 10}%`}></div>
      </div>
    </div>

    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
      <div class="text-xs text-slate-400 mb-1">客服响应与维护</div>
      <div class="text-xl font-bold font-mono text-violet-400">{provider.score.support * 10}%</div>
      <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
        <div class="bg-violet-500 h-full rounded-full" style={`width: ${provider.score.support * 10}%`}></div>
      </div>
    </div>

    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
      <div class="text-xs text-slate-400 mb-1">性价比评估</div>
      <div class="text-xl font-bold font-mono text-amber-400">{provider.score.value * 10}%</div>
      <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
        <div class="bg-amber-500 h-full rounded-full" style={`width: ${provider.score.value * 10}%`}></div>
      </div>
    </div>
  </div>

  <!-- Detailed Specifications & Analysis -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
    <!-- Left 2 Cols: Main Content -->
    <div class="lg:col-span-2 space-y-8 min-w-0">
      <!-- Section: Brand Background -->
      <div class="p-6 rounded-xl bg-slate-900/50 border border-slate-800 space-y-3">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <Icon name="server" class="w-4 h-4 text-tech-emerald" />
          <span>服务商架构与核心定位</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          {provider.description}
        </p>
      </div>

      <!-- Section: Pros & Cons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl bg-emerald-950/20 border border-emerald-500/20">
          <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
            <Icon name="check" class="w-4 h-4" />
            <span>核心优势 (Pros)</span>
          </div>
          <ul class="space-y-2 text-xs text-slate-300">
            {provider.pros.map((pro) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-bold">•</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-5 rounded-xl bg-rose-950/20 border border-rose-500/20">
          <div class="text-xs font-bold text-rose-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
            <Icon name="alert-triangle" class="w-4 h-4" />
            <span>注意事项与局限 (Cons)</span>
          </div>
          <ul class="space-y-2 text-xs text-slate-300">
            {provider.cons.map((con) => (
              <li class="flex items-start gap-2">
                <span class="text-rose-400 font-bold">•</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Section: Scenarios & AI Support -->
      <div class="p-6 rounded-xl bg-slate-900/50 border border-slate-800 space-y-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <Icon name="bot" class="w-4 h-4 text-tech-cyan" />
          <span>AI 访问、流媒体解锁与客户端模式</span>
        </h2>

        <div class={`p-3.5 rounded-lg border text-xs ${provider.subscriptionMode === 'client-only' ? 'bg-amber-950/30 border-amber-500/40 text-amber-200' : 'bg-slate-950 border-slate-900 text-slate-300'}`}>
          <div class="font-semibold mb-1">🔌 客户端与订阅方式：</div>
          <p>{subscriptionModeText}（适配列表：{provider.clients.join('、')}）</p>
        </div>

        <div class="space-y-3 text-xs">
          <div class="p-3 rounded-lg bg-slate-950 border border-slate-900">
            <div class="font-semibold text-slate-200 mb-1">🤖 AI 支持情况：</div>
            <p class="text-slate-400">{provider.aiSupport.notes}</p>
          </div>
          <div class="p-3 rounded-lg bg-slate-950 border border-slate-900">
            <div class="font-semibold text-slate-200 mb-1">🎬 流媒体解锁情况：</div>
            <p class="text-slate-400">{provider.streamingSupport.notes}</p>
          </div>
        </div>

        {provider.unlockMatrix && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-3.5 rounded-lg bg-slate-950/90 border border-slate-800/80 space-y-2">
              <div class="text-xs font-bold text-slate-200">AI 工具支持细目</div>
              <div class="space-y-1.5">
                {provider.unlockMatrix.ai.map((item) => {
                  const badge = unlockBadge(item.status);
                  return (
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-slate-300">{item.name}</span>
                      <span class={`px-2 py-0.5 rounded border text-[10px] font-medium ${badge.cls}`}>{badge.text}</span>
                    </div>
                  );
                })}
              </div>
            </div>
            <div class="p-3.5 rounded-lg bg-slate-950/90 border border-slate-800/80 space-y-2">
              <div class="text-xs font-bold text-slate-200">流媒体平台细目</div>
              <div class="space-y-1.5">
                {provider.unlockMatrix.streaming.map((item) => {
                  const badge = unlockBadge(item.status);
                  return (
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-slate-300">{item.name}</span>
                      <span class={`px-2 py-0.5 rounded border text-[10px] font-medium ${badge.cls}`}>{badge.text}</span>
                    </div>
                  );
                })}
              </div>
            </div>
            {provider.unlockMatrix.note && (
              <p class="sm:col-span-2 text-[11px] text-slate-400 bg-slate-950/60 p-2.5 rounded border border-slate-800/70">
                备注：{provider.unlockMatrix.note}
              </p>
            )}
          </div>
        )}
      </div>

      <!-- Section: Full Plans Matrix -->
      {provider.plans && provider.plans.length > 0 && (
        <div class="p-6 rounded-xl bg-slate-900/50 border border-slate-800 space-y-4">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <Icon name="layers" class="w-4 h-4 text-tech-emerald" />
              <span>官方套餐与价格明细</span>
            </h2>
            <span class="text-[11px] text-slate-400">以官方实时结算页面为准</span>
          </div>
          <div class="overflow-x-auto rounded-lg border border-slate-800">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="bg-slate-950 border-b border-slate-800 text-slate-300">
                  <th class="p-3 font-semibold">套餐名称</th>
                  <th class="p-3 font-semibold">周期</th>
                  <th class="p-3 font-semibold">价格</th>
                  <th class="p-3 font-semibold">流量配额</th>
                  <th class="p-3 font-semibold">规则说明</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/80 text-slate-300">
                {provider.plans.map((plan) => (
                  <tr class="hover:bg-slate-900/40">
                    <td class="p-3 font-medium text-white">{plan.name}</td>
                    <td class="p-3 text-slate-300">{plan.cycle}</td>
                    <td class="p-3 font-mono font-bold text-tech-emerald">{plan.price}</td>
                    <td class="p-3 font-mono">{plan.traffic}</td>
                    <td class="p-3 text-slate-400">{plan.periodNote || '-'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- Section: Regional Speed Metrics -->
      {provider.speedMetrics && provider.speedMetrics.rows.length > 0 && (
        <div class="p-6 rounded-xl bg-slate-900/50 border border-slate-800 space-y-4">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <Icon name="zap" class="w-4 h-4 text-tech-cyan" />
              <span>分地区节点延迟与吞吐参考</span>
            </h2>
            <span class="text-[11px] font-mono text-slate-400">采集日期：{provider.speedMetrics.testDate}</span>
          </div>
          <p class="text-xs text-slate-400 bg-slate-950/70 p-2.5 rounded-lg border border-slate-800/80">
            测试口径：{provider.speedMetrics.testNote}
          </p>
          <div class="overflow-x-auto rounded-lg border border-slate-800">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="bg-slate-950 border-b border-slate-800 text-slate-300">
                  <th class="p-3 font-semibold">目标地区</th>
                  <th class="p-3 font-semibold">延迟参考</th>
                  <th class="p-3 font-semibold">下载速率参考</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/80">
                {provider.speedMetrics.rows.map((row) => (
                  <tr class="hover:bg-slate-900/40">
                    <td class="p-3 font-medium text-white">{row.region}</td>
                    <td class="p-3 font-mono text-cyan-300">{row.latency}</td>
                    <td class="p-3 font-mono text-tech-emerald">{row.download}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- Section: Verification Gaps Notice -->
      {provider.verificationGaps && provider.verificationGaps.length > 0 && (
        <div class="p-5 rounded-xl bg-amber-950/20 border border-amber-500/30 space-y-2.5">
          <h2 class="text-sm font-bold text-amber-300 flex items-center gap-2">
            <Icon name="alert-triangle" class="w-4 h-4 text-amber-400" />
            <span>诚实标注：待核实与资料缺口说明</span>
          </h2>
          <p class="text-xs text-slate-300">本站严格区分已验证数据与待核实字段，不伪造测速结果。当前该品牌尚有以下待核实项：</p>
          <ul class="space-y-1.5 text-xs text-amber-200/90 list-disc pl-5">
            {provider.verificationGaps.map((gap) => (
              <li>{gap}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Section: Real Test Charts Gallery (if available) -->
      {provider.testImages && provider.testImages.length > 0 && (
        <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-6">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <Icon name="zap" class="w-5 h-5 text-tech-emerald" />
              <h2 class="text-lg font-bold text-white">真实测速与流媒体 / AI 解锁大图验证</h2>
            </div>
            <span class="text-xs font-mono text-slate-400">共 {provider.testImages.length} 组归档实测图</span>
          </div>

          <div class="space-y-6">
            {provider.testImages.map((img, idx) => (
              <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800 space-y-3">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-tech-emerald/20 text-tech-emerald">图 {idx + 1}</span>
                    <span>{img.title}</span>
                  </h3>
                  <a href={img.url} target="_blank" rel="noopener noreferrer" class="text-xs text-tech-cyan hover:underline flex items-center gap-1">
                    <span>查看原图</span>
                    <Icon name="external-link" class="w-3 h-3" />
                  </a>
                </div>

                <div class="rounded-lg overflow-hidden border border-slate-800 bg-slate-950 group">
                  <a href={img.url} target="_blank" rel="noopener noreferrer">
                    <img
                      src={img.url}
                      alt={`${provider.name} - ${img.title}`}
                      class="w-full h-auto max-h-[520px] object-contain mx-auto transition-transform duration-300 group-hover:scale-[1.01]"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>

                <p class="text-xs text-slate-400 leading-relaxed bg-slate-900/60 p-3 rounded-lg border border-slate-800/80">
                  <span class="text-tech-emerald font-semibold">实测分析结论：</span> {img.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Right 1 Col: Specs Sidebar -->
    <div class="space-y-6 min-w-0">
      <div class="p-6 rounded-xl bg-slate-900/80 border border-slate-800 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">规格参数速览</h3>
        <dl class="divide-y divide-slate-800 text-xs">
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-400">起步价格</dt>
            <dd class="font-bold text-tech-emerald font-mono">{hasPrice ? `¥${provider.pricing.minMonthly} / 月` : '待核实'}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-400">计费周期</dt>
            <dd class="text-slate-200 text-right max-w-[160px]">{provider.pricing.billingPeriod}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-400">支持协议</dt>
            <dd class="text-slate-200 font-mono uppercase text-right max-w-[160px]">{provider.protocols.join(', ')}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-400">专线类型</dt>
            <dd class="text-slate-200 uppercase text-right max-w-[160px]">{provider.routes.join(' + ')}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-400">月流量包</dt>
            <dd class="text-slate-200 text-right max-w-[160px]">{provider.bandwidthLimit}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-400">退款机制</dt>
            <dd class="text-slate-200 text-right max-w-[160px]">{provider.refundPolicy}</dd>
          </div>
        </dl>

        {provider.affiliateUrl ? (
          <div class="space-y-1.5">
            <a
              href={provider.affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-xs transition-all shadow-glow flex items-center justify-center gap-1.5"
            >
              <span>直达 {provider.name} 官网</span>
              <Icon name="external-link" class="w-3.5 h-3.5" />
            </a>
            <p class="text-[10px] text-slate-500 text-center">
              推广关系说明：含推广链接，通过链接注册可能为本站带来佣金，不影响您的实际支付价格。
            </p>
          </div>
        ) : (
          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-center text-xs text-slate-400">
            该品牌暂无已核实的独立注册入口，资料仅供历史对比参考。
          </div>
        )}
      </div>

      <!-- Verification & Compliance Status Card (Only Verified Fields) -->
      <div class="p-6 rounded-xl bg-slate-900/80 border border-slate-800 space-y-3.5">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-1.5">
            <span class={`w-2 h-2 rounded-full ${provider.status === 'active' ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
            <span>档案核验与状态记录</span>
          </h3>
          <span class="text-[10px] font-mono text-emerald-400 bg-emerald-950 px-2 py-0.5 rounded border border-emerald-500/30">
            {provider.status === 'active' ? '正常运营中' : '状态关注中'}
          </span>
        </div>

        <div class="space-y-2 text-xs text-slate-300">
          <div class="flex justify-between text-slate-400">
            <span>最近核验日期:</span>
            <span class="font-mono text-slate-200">{provider.lastVerified}</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>运营起始年份:</span>
            <span class="text-slate-200">{provider.establishedYear} 年</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>实测依据:</span>
            <span class="text-slate-200">{provider.testImages && provider.testImages.length > 0 ? `含 ${provider.testImages.length} 组测速/解锁图` : '套餐与线路公开参数核验'}</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>试用政策:</span>
            <span class="text-slate-200">{provider.pricing.hasTrial ? '支持试用' : '无免费试用（建议先月付）'}</span>
          </div>
        </div>

        <!-- Related Internal Navigation -->
        <div class="pt-3 border-t border-slate-800 space-y-2 text-xs">
          <div class="text-[11px] font-bold text-slate-400">站内关联专题与对比：</div>
          <div class="flex flex-wrap gap-1.5">
            <a href="/category/cost-effective" class="px-2 py-1 rounded bg-slate-950 border border-slate-800 text-slate-300 hover:text-tech-emerald transition-colors text-[11px]">
              性价比机场排行
            </a>
            <a href="/category/clash-recommend" class="px-2 py-1 rounded bg-slate-950 border border-slate-800 text-slate-300 hover:text-tech-cyan transition-colors text-[11px]">
              Clash 机场推荐
            </a>
            <a href="/category/airport-nodes" class="px-2 py-1 rounded bg-slate-950 border border-slate-800 text-slate-300 hover:text-tech-emerald transition-colors text-[11px]">
              高速机场节点
            </a>
            {reviewArticle && (
              <a href={`/articles/${reviewArticle.slug}`} class="px-2 py-1 rounded bg-slate-950 border border-slate-800 text-tech-cyan hover:underline text-[11px]">
                查看长篇实测报告 →
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Provider FAQ -->
  <div class="mb-10">
    <FaqSection faqs={providerFaqs} />
  </div>

  <!-- Topic Bridge -->
  <NextBestPage nextPages={nextPages} />
</BaseLayout>
