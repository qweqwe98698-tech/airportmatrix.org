---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import Icon from '@/components/common/Icon.astro';
import NextBestPage from '@/components/article/NextBestPage.astro';
import { clientsData } from '@/data/clients.data';
import { providersData } from '@/data/providers.data';

export function getStaticPaths() {
  return clientsData.map((client) => ({
    params: { slug: client.slug },
    props: { client },
  }));
}

const { client } = Astro.props;

// Filter top 4 providers compatible with this client
const compatibleProviders = providersData.filter((p) =>
  p.clients.includes(client.slug) || p.clients.includes(client.name.toLowerCase()) || p.clients.includes('clash-verge')
).slice(0, 4);

const breadcrumbs = [
  { name: '客户端教程中心', url: '/clients' },
  { name: `${client.name} 图文配置教程`, url: `/client/${client.slug}` },
];

const nextPages = [
  {
    title: '精选 16 大专线机场矩阵排行榜',
    href: '/providers',
    desc: `获取针对 ${client.name} 完美适配的 1Gbps 高速 IEPL 专线订阅。`,
    type: '节点推荐',
  },
  {
    title: '节点全红与 Timeout 故障排查手册',
    href: '/articles/node-timeout-troubleshooting-guide',
    desc: '遇到客户端无法拉取节点或测速全部超时时的系统化诊断流程。',
    type: '故障排查',
  },
];
---

<BaseLayout
  title={`${client.name} 2026 官方安全下载、图文安装与订阅配置教程 - AirportMatrix`}
  description={`手把手教您在 ${client.platforms.join('/')} 上安装 ${client.name}，并完成机场一键订阅导入、分流规则切换与 TUN 虚拟网卡配置。`}
  breadcrumbs={breadcrumbs}
  schemaType="SoftwareApplication"
  softwareData={{
    name: client.name,
    operatingSystem: client.platforms.join(', '),
    applicationCategory: 'NetworkingApplication',
    downloadUrl: client.downloadUrl,
    softwareVersion: '2026 Stable',
  }}
>
  <Breadcrumb items={breadcrumbs} />

  <!-- Client Hero Banner -->
  <div class="p-6 sm:p-10 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 border border-slate-800 mb-10 shadow-2xl relative overflow-hidden">
    <div class="absolute -top-24 -right-24 w-72 h-72 bg-tech-cyan/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative z-10">
      <div>
        <div class="flex items-center gap-2.5 mb-2">
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">{client.name}</h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-tech-cyan/20 text-tech-cyan border border-tech-cyan/30">
            {client.category.toUpperCase()}
          </span>
          {client.isRecommended && (
            <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">
              推荐首选
            </span>
          )}
        </div>
        <p class="text-xs sm:text-sm text-slate-300 max-w-3xl leading-relaxed">{client.tagline}</p>
        
        <div class="flex items-center gap-4 mt-5 flex-wrap text-xs">
          <div class="flex items-center gap-1.5 text-slate-400">
            <span class="text-slate-500 font-mono">底层内核:</span>
            <span class="text-slate-200 font-mono font-bold">{client.coreEngine}</span>
          </div>
          <div class="text-slate-700">|</div>
          <div class="flex items-center gap-1.5 text-slate-400">
            <span class="text-slate-500 font-mono">支持平台:</span>
            {client.platforms.map((p) => (
              <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-200 font-mono">
                {p}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3 flex-shrink-0">
        <a
          href={client.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>开源仓库</span>
          <Icon name="external-link" class="w-3.5 h-3.5" />
        </a>
        <a
          href={client.downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-teal-500 hover:from-cyan-400 hover:to-teal-400 text-slate-950 font-extrabold text-xs transition-all shadow-glow-cyan flex items-center gap-1.5"
        >
          <span>官方安全下载</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </div>

  <!-- Main Tutorial Section -->
  <div class="space-y-12 mb-16">
    
    <!-- Section 1: Introduction & Architecture -->
    <div class="p-6 sm:p-8 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-4">
      <div class="flex items-center gap-2">
        <Icon name="cpu" class="w-5 h-5 text-tech-cyan" />
        <h2 class="text-xl font-bold text-white">一、 客户端特性与核心定位</h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{client.description}</p>
      
      <!-- Pros and Cons Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="p-5 rounded-xl bg-emerald-950/20 border border-emerald-500/30 space-y-2">
          <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider">核心技术优势 (Pros)</div>
          <ul class="space-y-1.5 text-xs text-slate-300">
            {client.pros.map((pro) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-5 rounded-xl bg-amber-950/20 border border-amber-500/30 space-y-2">
          <div class="text-xs font-bold text-amber-400 uppercase tracking-wider">使用须知与门槛 (Cons)</div>
          <ul class="space-y-1.5 text-xs text-slate-300">
            {client.cons.map((con) => (
              <li class="flex items-start gap-2">
                <span class="text-amber-400 font-bold">!</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Section 2: Step-by-Step Visual Walkthrough (图文流程) -->
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tech-cyan/10 border border-tech-cyan/30 text-tech-cyan text-xs font-semibold mb-2">
            <Icon name="zap" class="w-3.5 h-3.5" />
            <span>4 步保姆级图文教程</span>
          </div>
          <h2 class="text-2xl font-bold text-white tracking-tight">二、 {client.name} 完整配置与订阅实战</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {client.steps.map((step) => (
          <div class="p-6 sm:p-7 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-all flex flex-col justify-between space-y-4 group">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-lg text-xs font-bold font-mono bg-slate-800 text-tech-cyan border border-slate-700">
                  {step.badge}
                </span>
                <span class="text-2xl font-black text-slate-700 group-hover:text-tech-cyan transition-colors">
                  0{step.stepNumber}
                </span>
              </div>

              <h3 class="text-lg font-bold text-white group-hover:text-tech-cyan transition-colors">
                {step.title}
              </h3>

              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                {step.desc}
              </p>
            </div>

            <!-- UI Highlights Box -->
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-850 space-y-1.5">
              <div class="text-[11px] font-bold text-slate-400 flex items-center gap-1">
                <Icon name="sparkles" class="w-3 h-3 text-tech-emerald" />
                <span>操作关键要点：</span>
              </div>
              <ul class="space-y-1 text-[11px] text-slate-400">
                {step.uiHighlights.map((hl) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-tech-emerald">▸</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Section 3: Recommended Configuration Snippet -->
    {client.recommendedConfigSnippet && (
      <div class="p-6 sm:p-8 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <Icon name="code" class="w-5 h-5 text-tech-emerald" />
            <h2 class="text-lg font-bold text-white">三、 推荐 TUN 模式与 Fake-IP 高级配置模板</h2>
          </div>
          <span class="text-xs text-slate-500 font-mono">Mihomo (Clash.Meta) YAML</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-400">
          若您需要解决 Telegram 断连、Steam 社区打不开或终端 Git 报错，可将以下代码片段追加或覆盖至客户端配置中：
        </p>
        <pre class="p-4 rounded-xl bg-slate-950 border border-slate-850 text-xs font-mono text-emerald-300 overflow-x-auto leading-relaxed"><code>{client.recommendedConfigSnippet}</code></pre>
      </div>
    )}

    <!-- Section 4: 1-Click Compatible Airport Subscriptions -->
    <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-900 via-slate-950 to-slate-950 border border-slate-800 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <Icon name="server" class="w-5 h-5 text-tech-cyan" />
            <span>适配 {client.name} 的 1Gbps 高速专线订阅源推荐</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1">均通过 9Gbps 宽带真实测速，支持一键导入与全节点 FullCone UDP：</p>
        </div>
        <a href="/providers" class="text-xs font-semibold text-tech-cyan hover:underline flex items-center gap-1">
          <span>查看全部 16 家品牌</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {compatibleProviders.map((provider) => (
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-4">
            <div>
              <div class="font-bold text-white text-sm">{provider.name}</div>
              <div class="text-xs text-slate-400 mt-0.5">{provider.pricing.billingPeriod}</div>
              {provider.couponCode && (
                <div class="text-[11px] text-tech-emerald font-mono mt-1">
                  券码: <strong class="bg-emerald-950 px-1.5 py-0.2 rounded border border-emerald-500/30">{provider.couponCode}</strong>
                </div>
              )}
            </div>
            <a
              href={provider.affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="px-3.5 py-2 rounded-lg bg-tech-emerald text-slate-950 font-bold text-xs hover:bg-emerald-400 transition-colors flex-shrink-0"
            >
              获取订阅
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Section 5: Troubleshooting Matrix -->
    {client.troubleshooting.length > 0 && (
      <div class="p-6 sm:p-8 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-4">
        <div class="flex items-center gap-2">
          <Icon name="info" class="w-5 h-5 text-amber-400" />
          <h2 class="text-lg font-bold text-white">五、 常见报错与排错速查手册</h2>
        </div>

        <div class="space-y-3">
          {client.troubleshooting.map((item) => (
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-900 space-y-1.5">
              <div class="text-xs sm:text-sm font-bold text-rose-400 flex items-center gap-2">
                <span>✕ 常见现象：</span>
                <span>{item.issue}</span>
              </div>
              <div class="text-xs text-slate-400">
                <span class="text-slate-500">故障原因：</span> {item.cause}
              </div>
              <div class="text-xs text-emerald-300">
                <span class="text-emerald-500 font-semibold">✔ 解决方案：</span> {item.solution}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Topic Bridge Recommendation -->
    <NextBestPage nextPages={nextPages} />
  </div>
</BaseLayout>
