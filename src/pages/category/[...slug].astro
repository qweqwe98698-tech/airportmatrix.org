---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import ProviderCard from '@/components/provider/ProviderCard.astro';
import ProviderCompareTable from '@/components/provider/ProviderCompareTable.astro';
import QuickAnswer from '@/components/article/QuickAnswer.astro';
import FaqSection from '@/components/article/FaqSection.astro';
import NextBestPage from '@/components/article/NextBestPage.astro';
import Icon from '@/components/common/Icon.astro';
import { categoriesData } from '@/data/categories.data';
import { providersData } from '@/data/providers.data';
import { articlesData } from '@/data/articles.data';

export function getStaticPaths() {
  return categoriesData.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

// Filter matching providers preserving editorial priority order
const matchedProviders = category.matchedProviderSlugs
  .map((slug) => providersData.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Resolve cluster articles linked to this Pillar
const clusterArticles = category.recommendedArticleSlugs
  .map((slug) => articlesData.find((a) => a.slug === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

// Resolve sibling Pillars and tools for NextBestPage
const relatedCategories = category.relatedCategorySlugs
  .map((slug) => categoriesData.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const nextPages = [
  ...relatedCategories.slice(0, 2).map((c) => ({
    title: c.name,
    href: `/category/${c.slug}`,
    desc: c.tagline,
    type: '关联专题榜',
  })),
  {
    title: '智能机场推荐选型向导',
    href: '/recommend/wizard',
    desc: '按预算、主力场景（AI / 4K流媒体 / 办公）30秒筛选最适合你的专线方案。',
    type: '选型工具',
  },
  {
    title: '在线机场订阅转换与分流工具',
    href: '/tools/sub-converter',
    desc: '本地纯前端将订阅链接转换为 Clash Verge / Sing-box / Shadowrocket 格式。',
    type: '实用工具',
  },
];

const itemListSchemaData = matchedProviders.map((p) => ({
  name: `${p.name} - ${p.tagline}`,
  url: `/provider/${p.slug}`,
}));

const breadcrumbs = [
  { name: '场景矩阵中心', url: '/providers' },
  { name: category.name, url: `/category/${category.slug}` },
];
---

<BaseLayout
  title={category.metaTitle}
  description={category.description}
  schemaType="ItemList"
  itemList={itemListSchemaData}
  faqData={category.faqList}
  breadcrumbs={breadcrumbs}
>
  <Breadcrumb items={breadcrumbs} />

  <!-- Header -->
  <div class="mb-6 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 border border-slate-800 relative overflow-hidden">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tech-emerald/10 border border-tech-emerald/30 text-tech-emerald text-xs font-semibold mb-3">
      <Icon name="sparkles" class="w-3.5 h-3.5" />
      <span>Pillar 专题矩阵 · 实测收录 {matchedProviders.length} 家在营品牌</span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">{category.name}</h1>
    <p class="text-xs sm:text-base text-slate-300 mt-2 max-w-3xl leading-relaxed">{category.tagline}</p>
    <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-3xl">{category.description}</p>

    <!-- In-Page Quick Navigation TOC -->
    <div class="mt-5 pt-4 border-t border-slate-800/80 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-slate-400 font-semibold mr-1">本页目录：</span>
      <a href="#quick-answer" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-300 hover:text-tech-cyan transition-colors">核心结论</a>
      <a href="#buying-guide" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-300 hover:text-tech-cyan transition-colors">选购与避坑指南</a>
      <a href="#compare-table" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-300 hover:text-tech-cyan transition-colors">参数横评表</a>
      <a href="#provider-cards" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-300 hover:text-tech-cyan transition-colors">推荐服务商榜</a>
      <a href="#cluster-articles" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-300 hover:text-tech-cyan transition-colors">深度延伸阅读</a>
      <a href="#category-faq" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-300 hover:text-tech-cyan transition-colors">常见问题 FAQ</a>
    </div>
  </div>

  <!-- GEO Quick Answer -->
  <div id="quick-answer">
    <QuickAnswer answer={category.quickAnswer} />
  </div>

  <!-- Buying Guide & Key Features -->
  <div id="buying-guide" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="md:col-span-2 p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2.5">
      <h2 class="text-base font-bold text-white flex items-center gap-2">
        <Icon name="shield" class="w-4 h-4 text-tech-emerald" />
        <span>场景选购与避坑指南</span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        {category.buyingGuide}
      </p>
      <div class="pt-2 flex flex-wrap gap-3 text-xs text-slate-400">
        <a href="/methodology" class="text-tech-cyan hover:underline">查看客观测评维度标准 →</a>
        <a href="/risks" class="text-slate-300 hover:text-tech-emerald hover:underline">核对全网跑路风险监控台 →</a>
      </div>
    </div>

    <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-3">
      <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider">核心必备技术指标</h3>
      <ul class="space-y-2 text-xs text-slate-300">
        {category.features.map((feat) => (
          <li class="flex items-center gap-2">
            <span class="text-tech-emerald font-bold">✓</span>
            <span>{feat}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Comparison Table -->
  <div id="compare-table" class="mb-12 space-y-4">
    <div class="flex items-center justify-between pb-2 border-b border-slate-800">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <Icon name="layers" class="w-4 h-4 text-tech-emerald" />
        <span>核心参数与套餐横评对比表</span>
      </h2>
      <span class="text-xs text-slate-500">价格、专线与协议一目了然</span>
    </div>
    <ProviderCompareTable providers={matchedProviders} />
  </div>

  <!-- Providers List for this Category -->
  <div id="provider-cards" class="mb-12 space-y-4">
    <div class="flex items-center justify-between pb-2 border-b border-slate-800">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <Icon name="server" class="w-4 h-4 text-tech-cyan" />
        <span>精选推荐服务商矩阵 ({matchedProviders.length})</span>
      </h2>
      <span class="text-xs text-slate-500 font-mono">按综合实测与场景匹配度排序</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
      {matchedProviders.map((provider, idx) => (
        <ProviderCard provider={provider} rank={idx + 1} />
      ))}
    </div>
  </div>

  <!-- Cluster Articles Bridge -->
  {clusterArticles.length > 0 && (
    <div id="cluster-articles" class="mb-12 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-slate-800">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <Icon name="sparkles" class="w-4 h-4 text-violet-400" />
          <span>专题延伸阅读与深度实测指南 ({clusterArticles.length})</span>
        </h2>
        <a href="/articles" class="text-xs text-tech-cyan hover:underline">查看全部深度指南 →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {clusterArticles.map((article) => (
          <a
            href={`/articles/${article.slug}`}
            class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-tech-cyan/40 transition-all group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center gap-2 mb-2 text-[11px] font-mono text-slate-400">
                <span class="px-2 py-0.5 rounded bg-slate-800 text-tech-emerald uppercase">{article.articleType}</span>
                <span>更新于 {article.updatedDate}</span>
                <span>· {article.readingTime}</span>
              </div>
              <h3 class="text-sm sm:text-base font-bold text-slate-100 group-hover:text-tech-cyan transition-colors line-clamp-2">
                {article.title}
              </h3>
              <p class="text-xs text-slate-400 mt-1.5 line-clamp-2 leading-relaxed">{article.description}</p>
            </div>
            <div class="mt-3 pt-2 border-t border-slate-800/60 text-xs text-tech-cyan flex items-center justify-between">
              <span>阅读全文与步骤拆解</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Category FAQ -->
  {category.faqList.length > 0 && (
    <div id="category-faq">
      <FaqSection faqs={category.faqList} />
    </div>
  )}

  <!-- Next Best Page Bridge -->
  <NextBestPage nextPages={nextPages} />
</BaseLayout>
