---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import SmartRecommender from '@/components/matrix/SmartRecommender.astro';
import NextBestPage from '@/components/article/NextBestPage.astro';

const breadcrumbs = [{ name: '智能选型向导', url: '/recommend' }];

const nextPages = [
  {
    title: '查看所有机场多维参数对比',
    href: '/providers',
    desc: '在矩阵库中按线路、协议、价格与流媒体能力自由筛选。',
    type: '综合矩阵',
  },
  {
    title: 'Clash Verge Rev 客户端新手指南',
    href: '/client/clash-verge',
    desc: '选定机场后，手把手教您如何快速导入订阅并开启高速分流。',
    type: '客户端教程',
  },
];
---

<BaseLayout
  title="机场选型决策中心 · 场景与预算匹配指南 (2026)"
  description="从使用场景、终端设备到网络协议全方位选型决策指南。基于真实网络监测数据与用户反馈画像，助您快速甄选最适用的高可用专线服务商。"
  breadcrumbs={breadcrumbs}
>
  <Breadcrumb items={breadcrumbs} />

  <div class="mb-8 text-center max-w-2xl mx-auto">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">机场代理选型决策中心</h1>
    <p class="text-xs sm:text-sm text-slate-400 mt-2">
      拒绝盲目跟风与劣质小机场。基于真实网络监测数据与用户画像模型，全方位指引您的网络方案决策。
    </p>
  </div>

  <div class="mb-12">
    <SmartRecommender />
  </div>

  <NextBestPage nextPages={nextPages} />
</BaseLayout>
