---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroMatrix from '@/components/home/HeroMatrix.astro';
import IntentCards from '@/components/home/IntentCards.astro';
import RecommendationWizard from '@/components/home/RecommendationWizard.astro';
import FeaturedEntityCards from '@/components/home/FeaturedEntityCards.astro';
import EntityCards from '@/components/home/EntityCards.astro';
import KnowledgeHub from '@/components/home/KnowledgeHub.astro';
import RiskDashboard from '@/components/home/RiskDashboard.astro';
import IntelligenceFeed from '@/components/home/IntelligenceFeed.astro';
import CTASection from '@/components/home/CTASection.astro';
---

<BaseLayout
  title="2026 性价比机场推荐与机场测评排行 - 好用的 Clash 机场节点实测榜"
  description="2026 最新机场测评与好用的机场推荐榜！实测对比 42 家机场服务商与历史档案、高性价比机场、高速稳定机场节点、Clash 机场推荐方案与月付/年付优惠，公开三网测速图、ChatGPT 原生解锁与跑路风险实时监控。"
>
  <!-- 1. 第一屏：Hero 区域 + 平台大标题 + 热门搜索框 + 四大数据库权威指标 -->
  <HeroMatrix />

  <!-- 2. 第二屏：热门需求与场景入口 (AI访问 / 流媒体 / 客户端 / 稳定专线 / 便宜月付 / 故障诊断) -->
  <IntentCards />

  <!-- 3. 第三屏：智能代理选型向导 (3 步交互匹配 + 数据库实体结果) -->
  <RecommendationWizard />

  <!-- 4. 第四屏：数据库精选实体与多维关系图谱 (双列高密度实体卡片 + 关联知识) -->
  <FeaturedEntityCards />

  <!-- 5. 第五屏：5 大核心知识图谱数据库矩阵导航 (Provider / Client / Protocol / Route / Issues) -->
  <EntityCards />
  <KnowledgeHub />

  <!-- 6. 第六屏：机场风险监控雷达与实时状态仪表盘 -->
  <RiskDashboard />

  <!-- 7. 第七屏：最新情报中心与 2026 深度实测报告流 -->
  <IntelligenceFeed />

  <!-- 8. 第八屏：全球网络生态行动号召 -->
  <CTASection />
</BaseLayout>
