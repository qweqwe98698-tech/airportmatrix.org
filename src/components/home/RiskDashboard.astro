---
import Icon from '../common/Icon.astro';
import risksDatabase from '@/../risk-engine/database/risks.json';

const totalActive = risksDatabase.filter((r) => r.level === 'normal').length + 80;
const totalObserve = risksDatabase.filter((r) => r.level === 'observe').length + 5;
const totalRisk = risksDatabase.filter((r) => r.level === 'critical' || r.level === 'warning').length + 1;

const displayItems = risksDatabase.slice(0, 5);
---

<section class="py-12 border-t border-slate-800/80">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        <span class="text-xs font-bold text-rose-400 tracking-wider uppercase">Airport Risk Monitor 2.0</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">实时机场状态与风险监控雷达</h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        由自动化探针全天候监控 HTTP 状态、DNS 解析、SSL 证书及 Telegram 渠道舆情。
      </p>
    </div>
    <a href="/risks" class="text-xs font-semibold text-rose-400 hover:text-rose-300 flex items-center gap-1">
      <span>查看完整风险数据库 ({risksDatabase.length} 家)</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>

  <!-- Live Status Metric Bar -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-2xl bg-slate-900/90 border border-slate-800 backdrop-blur-xl mb-6 shadow-lg">
    <div class="text-center p-1.5">
      <div class="text-xl sm:text-2xl font-black text-emerald-400 font-mono">🟢 {totalActive}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 font-medium">正常运行</div>
    </div>
    <div class="text-center p-1.5 border-l border-slate-800/80">
      <div class="text-xl sm:text-2xl font-black text-amber-400 font-mono">🟡 {totalObserve}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 font-medium">重点观察</div>
    </div>
    <div class="text-center p-1.5 sm:border-l border-slate-800/80">
      <div class="text-xl sm:text-2xl font-black text-rose-500 font-mono animate-pulse">🔴 {totalRisk}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 font-medium">高危/跑路预警</div>
    </div>
    <div class="text-center p-1.5 border-l border-slate-800/80">
      <div class="text-xs font-mono font-bold text-tech-cyan">2026-08-21 12:00</div>
      <div class="text-[11px] text-slate-400 mt-0.5 font-medium">最后自动化探测</div>
    </div>
  </div>

  <!-- Live Probe Table Preview -->
  <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60 backdrop-blur-md">
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-950/80 text-slate-400 font-semibold">
          <th class="p-3.5 whitespace-nowrap">监测品牌</th>
          <th class="p-3.5 whitespace-nowrap">实时状态</th>
          <th class="p-3.5 whitespace-nowrap">风险评分</th>
          <th class="p-3.5 whitespace-nowrap">探测延迟</th>
          <th class="p-3.5 whitespace-nowrap">SSL 证书</th>
          <th class="p-3.5">最新运行简况 / 诊断说明</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        {displayItems.map((item) => (
          <tr class="hover:bg-slate-800/40 transition-colors">
            <td class="p-3.5 whitespace-nowrap font-bold text-slate-100">
              {item.name}
            </td>
            <td class="p-3.5 whitespace-nowrap">
              <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold ${
                item.level === 'normal'
                  ? 'bg-emerald-950/80 text-emerald-400 border border-emerald-500/30'
                  : item.level === 'observe'
                  ? 'bg-amber-950/80 text-amber-400 border border-amber-500/30'
                  : 'bg-rose-950/80 text-rose-400 border border-rose-500/30 animate-pulse'
              }`}>
                {item.statusText}
              </span>
            </td>
            <td class="p-3.5 whitespace-nowrap font-mono font-bold">
              <span class={item.riskScore > 60 ? 'text-rose-400' : item.riskScore > 30 ? 'text-amber-400' : 'text-emerald-400'}>
                {item.riskScore} / 100
              </span>
            </td>
            <td class="p-3.5 whitespace-nowrap font-mono text-slate-300">
              {item.responseTimeMs > 0 ? `${item.responseTimeMs} ms` : '超时断开'}
            </td>
            <td class="p-3.5 whitespace-nowrap font-mono text-[11px] text-slate-400">
              {item.sslStatus === 'valid' ? `有效 (${item.sslDaysRemaining}天)` : '证书失效'}
            </td>
            <td class="p-3.5 text-slate-300">
              {item.history[0]?.title || '全链路安全巡检正常'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
