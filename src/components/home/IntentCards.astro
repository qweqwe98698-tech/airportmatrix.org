---
import Icon from '../common/Icon.astro';

const intents = [
  {
    title: '2026 性价比机场排行',
    badge: 'TOP RANK',
    icon: 'zap',
    desc: '月均 7.5~15 元高性价比专线实测 · 14.9 元 100GB 月付 · 拒绝虚标与跑路作坊',
    href: '/category/cost-effective',
    color: 'emerald',
    tags: ['性价比机场', '14.9元月付', '年付7.5元起'],
  },
  {
    title: 'Clash 机场推荐精选',
    badge: 'CLASH READY',
    icon: 'cpu',
    desc: '完美适配 Clash Verge Rev / Mihomo / 小火箭 · 一键导入机场订阅与自动分流',
    href: '/category/clash-recommend',
    color: 'cyan',
    tags: ['Clash推荐', '一键订阅', 'Mihomo规则'],
  },
  {
    title: '高速机场节点测评榜',
    badge: 'NODES',
    icon: 'server',
    desc: '香港 · 日本 · 新加坡 · 台湾 · 美国 IEPL 专线机场节点晚高峰实测与延迟对比',
    href: '/category/airport-nodes',
    color: 'violet',
    tags: ['机场节点', 'IEPL专线', '晚高峰不卡'],
  },
  {
    title: 'AI 访问专线机场',
    badge: 'AI ACCESS',
    icon: 'bot',
    desc: 'ChatGPT · Claude · Gemini · 原生住宅 IP 避开 1020 报错与高频验证码风控',
    href: '/category/ai-access',
    color: 'emerald',
    tags: ['ChatGPT解锁', '原生IP', 'Cursor开发'],
  },
  {
    title: '4K/8K 流媒体机场',
    badge: 'STREAMING',
    icon: 'tv',
    desc: 'Netflix 非自制剧 · YouTube 8K · Disney+ · 巴哈姆特动画疯秒开不转圈',
    href: '/category/streaming-4k',
    color: 'amber',
    tags: ['Netflix 4K', '多区解锁', 'TikTok直播'],
  },
  {
    title: '机场节点超时排查',
    badge: 'ISSUES',
    icon: 'alert-triangle',
    desc: '节点全部超时 · Timeout 测速全红 · 端口冲突 · Clash 订阅拉取失败自救指南',
    href: '/articles/node-timeout-troubleshooting-guide',
    color: 'rose',
    tags: ['Timeout排查', '节点全红', '订阅修复'],
  },
];
---

<section class="py-10">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-tech-cyan"></span>
        <span class="text-xs font-bold text-tech-cyan tracking-wider uppercase">Best Picks 2026</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">2026 好用的机场与核心选型榜单</h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        按性价比、Clash 兼容性、高速机场节点与 AI/流媒体场景直达实测排行榜。
      </p>
    </div>
    <a href="/providers" class="hidden sm:flex text-xs font-semibold text-tech-cyan hover:underline items-center gap-1">
      <span>查看全部机场测评排行</span>
      <span>→</span>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {intents.map((item) => (
      <a
        href={item.href}
        class="glass-card-hover rounded-2xl p-6 border border-slate-800/80 flex flex-col justify-between group relative overflow-hidden"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center ${
              item.color === 'emerald' ? 'bg-emerald-500/20 text-emerald-400' :
              item.color === 'cyan' ? 'bg-cyan-500/20 text-cyan-400' :
              item.color === 'rose' ? 'bg-rose-500/20 text-rose-400' :
              item.color === 'amber' ? 'bg-amber-500/20 text-amber-400' :
              'bg-violet-500/20 text-violet-400'
            }`}>
              <Icon name={item.icon} class="w-5 h-5" />
            </div>
            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-800">
              {item.badge}
            </span>
          </div>

          <h3 class="text-lg font-bold text-white group-hover:text-tech-cyan transition-colors mb-1.5 flex items-center justify-between">
            <span>{item.title}</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-tech-cyan" />
          </h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            {item.desc}
          </p>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-3 border-t border-slate-800/60">
          {item.tags.map((tag) => (
            <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-950 text-slate-400 border border-slate-850 font-mono">
              #{tag}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
