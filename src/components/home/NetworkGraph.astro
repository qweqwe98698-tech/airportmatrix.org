---
import Icon from '../common/Icon.astro';
---

<div class="relative w-full h-[360px] sm:h-[400px] flex items-center justify-center overflow-hidden select-none">
  <!-- Glowing central aura -->
  <div class="absolute w-48 h-48 bg-tech-emerald/15 rounded-full blur-3xl animate-pulse pointer-events-none"></div>
  <div class="absolute w-64 h-64 bg-tech-cyan/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- SVG Connection Lines -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="lineGradEmerald" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#10b981" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.2"/>
      </linearGradient>
      <linearGradient id="lineGradCyan" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.2"/>
      </linearGradient>
    </defs>

    <!-- Radiating connection lines from center (50%, 50%) -->
    <line x1="50%" y1="50%" x2="20%" y2="25%" stroke="url(#lineGradEmerald)" stroke-width="1.5" stroke-dasharray="4 4" class="animate-pulse" />
    <line x1="50%" y1="50%" x2="80%" y2="25%" stroke="url(#lineGradCyan)" stroke-width="1.5" stroke-dasharray="4 4" class="animate-pulse" />
    <line x1="50%" y1="50%" x2="15%" y2="70%" stroke="url(#lineGradEmerald)" stroke-width="1.5" stroke-dasharray="4 4" />
    <line x1="50%" y1="50%" x2="85%" y2="70%" stroke="url(#lineGradCyan)" stroke-width="1.5" stroke-dasharray="4 4" />
    <line x1="50%" y1="50%" x2="50%" y2="88%" stroke="url(#lineGradEmerald)" stroke-width="1.5" stroke-dasharray="4 4" />
    <line x1="50%" y1="50%" x2="50%" y2="12%" stroke="url(#lineGradCyan)" stroke-width="1.5" stroke-dasharray="4 4" />
  </svg>

  <!-- Center Core Node: AirportMatrix -->
  <div class="relative z-10 p-1 rounded-2xl bg-gradient-to-tr from-tech-emerald via-tech-cyan to-tech-blue shadow-glow hover:scale-105 transition-transform duration-300">
    <div class="px-5 py-4 rounded-[14px] bg-slate-950/95 backdrop-blur-xl border border-slate-800 text-center flex flex-col items-center">
      <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center mb-1 shadow-sm">
        <Icon name="sparkles" class="w-5 h-5" />
      </div>
      <div class="text-xs font-mono font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 tracking-wider">
        AirportMatrix X
      </div>
      <div class="text-[9px] text-slate-400 font-mono mt-0.5">Core Intelligence</div>
    </div>
  </div>

  <!-- Node 1: AI (Top) -->
  <a href="/ai" class="absolute top-[8%] left-1/2 -translate-x-1/2 p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-tech-emerald/50 hover:bg-slate-800/90 transition-all flex items-center gap-2 group shadow-lg">
    <div class="w-6 h-6 rounded-md bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
      <Icon name="bot" class="w-3.5 h-3.5" />
    </div>
    <div class="text-left">
      <div class="text-[11px] font-bold text-slate-200 group-hover:text-emerald-300">海外 AI 访问</div>
      <div class="text-[9px] text-slate-500 font-mono">ChatGPT · Claude</div>
    </div>
  </a>

  <!-- Node 2: Client (Top Left) -->
  <a href="/clients" class="absolute top-[20%] left-[10%] sm:left-[15%] p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-tech-cyan/50 hover:bg-slate-800/90 transition-all flex items-center gap-2 group shadow-lg">
    <div class="w-6 h-6 rounded-md bg-cyan-500/20 text-cyan-400 flex items-center justify-center">
      <Icon name="cpu" class="w-3.5 h-3.5" />
    </div>
    <div class="text-left">
      <div class="text-[11px] font-bold text-slate-200 group-hover:text-cyan-300">客户端中枢</div>
      <div class="text-[9px] text-slate-500 font-mono">Clash · sing-box</div>
    </div>
  </a>

  <!-- Node 3: Provider (Top Right) -->
  <a href="/providers" class="absolute top-[20%] right-[10%] sm:right-[15%] p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-tech-emerald/50 hover:bg-slate-800/90 transition-all flex items-center gap-2 group shadow-lg">
    <div class="w-6 h-6 rounded-md bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
      <Icon name="server" class="w-3.5 h-3.5" />
    </div>
    <div class="text-left">
      <div class="text-[11px] font-bold text-slate-200 group-hover:text-emerald-300">机场品牌库</div>
      <div class="text-[9px] text-slate-500 font-mono">IEPL 专线矩阵</div>
    </div>
  </a>

  <!-- Node 4: Protocol (Bottom Left) -->
  <a href="/protocols" class="absolute bottom-[20%] left-[8%] sm:left-[12%] p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-violet-500/50 hover:bg-slate-800/90 transition-all flex items-center gap-2 group shadow-lg">
    <div class="w-6 h-6 rounded-md bg-violet-500/20 text-violet-400 flex items-center justify-center">
      <Icon name="layers" class="w-3.5 h-3.5" />
    </div>
    <div class="text-left">
      <div class="text-[11px] font-bold text-slate-200 group-hover:text-violet-300">协议百科</div>
      <div class="text-[9px] text-slate-500 font-mono">VLESS · Hysteria 2</div>
    </div>
  </a>

  <!-- Node 5: Streaming (Bottom Right) -->
  <a href="/streaming" class="absolute bottom-[20%] right-[8%] sm:right-[12%] p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-cyan-500/50 hover:bg-slate-800/90 transition-all flex items-center gap-2 group shadow-lg">
    <div class="w-6 h-6 rounded-md bg-cyan-500/20 text-cyan-400 flex items-center justify-center">
      <Icon name="tv" class="w-3.5 h-3.5" />
    </div>
    <div class="text-left">
      <div class="text-[11px] font-bold text-slate-200 group-hover:text-cyan-300">4K/8K 流媒体</div>
      <div class="text-[9px] text-slate-500 font-mono">Netflix · YouTube</div>
    </div>
  </a>

  <!-- Node 6: Risk Monitor (Bottom) -->
  <a href="/risks" class="absolute bottom-[6%] left-1/2 -translate-x-1/2 p-2 rounded-xl bg-slate-900/90 border border-rose-500/30 hover:border-rose-500/60 hover:bg-slate-800/90 transition-all flex items-center gap-2 group shadow-lg">
    <div class="w-5 h-5 rounded-md bg-rose-500/20 text-rose-400 flex items-center justify-center">
      <Icon name="alert-triangle" class="w-3 h-3" />
    </div>
    <div class="text-left">
      <div class="text-[10px] font-bold text-rose-400 group-hover:text-rose-300">实时跑路风险监控</div>
    </div>
  </a>
</div>
