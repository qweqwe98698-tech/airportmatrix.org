---
import Icon from '../common/Icon.astro';
import NetworkGraph from './NetworkGraph.astro';
---

<section class="relative pt-6 pb-12 flex flex-col justify-between overflow-hidden">
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b12_1px,transparent_1px),linear-gradient(to_bottom,#1e293b12_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>

  <!-- Top Hero Header & Grid -->
  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center max-w-7xl mx-auto w-full px-2 sm:px-4 mb-8">
    <!-- Left Column: Typography & Action -->
    <div class="lg:col-span-7 text-left space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-800 text-xs text-slate-300 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-tech-emerald animate-pulse"></span>
        <span class="font-mono text-emerald-400 font-bold">2026 机场测评实验室</span>
        <span class="text-slate-600">|</span>
        <span>性价比机场 · 好用的机场推荐 · 机场节点实测</span>
      </div>

      <div>
        <div class="text-sm sm:text-base font-extrabold tracking-widest text-tech-emerald uppercase mb-1 font-mono">
          AirportMatrix 2026
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
          性价比机场推荐与测评榜
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-medium mt-3 leading-relaxed">
          全面实测与档案追踪 42 家机场服务商、高速机场节点与 Clash 机场推荐方案，轻量化年付均摊 7.5 元/月起，实时核验测试图与跑路风险。
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="/category/cost-effective"
          class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-extrabold text-xs sm:text-sm transition-all shadow-glow hover:shadow-glow-cyan flex items-center gap-2"
        >
          <Icon name="sparkles" class="w-4 h-4" />
          <span>2026 性价比机场榜</span>
        </a>
        <a
          href="/providers"
          class="px-5 py-3.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700 hover:border-slate-600 font-semibold text-xs sm:text-sm transition-all flex items-center gap-2"
        >
          <Icon name="server" class="w-4 h-4 text-tech-cyan" />
          <span>查看全站机场测评对比</span>
        </a>
        <a
          href="/category/clash-recommend"
          class="px-4 py-3.5 rounded-xl bg-transparent hover:bg-slate-900/40 text-slate-400 hover:text-slate-200 text-xs sm:text-sm transition-colors"
        >
          Clash 机场推荐 →
        </a>
      </div>
    </div>

    <!-- Right Column: Animated Matrix Network Graph -->
    <div class="lg:col-span-5 relative">
      <NetworkGraph />
    </div>
  </div>

  <!-- Search Box Component with Specific Hot Pills -->
  <div class="relative z-10 w-full max-w-4xl mx-auto mb-10">
    <form action="/search" method="get" class="relative group">
      <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-tech-emerald/30 via-tech-cyan/30 to-tech-violet/30 opacity-75 blur-lg group-hover:opacity-100 transition duration-500 group-hover:duration-200"></div>
      
      <div class="relative flex items-center h-[68px] sm:h-[76px] rounded-2xl bg-slate-950/90 border border-slate-700/80 shadow-2xl backdrop-blur-2xl px-4 sm:px-6 transition-all focus-within:border-tech-cyan focus-within:ring-2 focus-within:ring-tech-cyan/20">
        <div class="text-slate-400 mr-3.5 flex-shrink-0">
          <Icon name="search" class="w-5 h-5 sm:w-6 sm:h-6 text-slate-400 group-focus-within:text-tech-cyan transition-colors" />
        </div>

        <input
          type="text"
          name="q"
          placeholder="搜索性价比机场、好用的机场推荐、Clash机场节点、u1s1测评或 ChatGPT 解锁..."
          class="w-full h-full bg-transparent text-slate-100 placeholder-slate-500 text-xs sm:text-base outline-none font-medium pr-20"
          autocomplete="off"
        />

        <div class="flex items-center gap-2 flex-shrink-0">
          <kbd class="hidden sm:inline-flex items-center px-2 py-1 text-[11px] font-mono bg-slate-900 text-slate-400 rounded-lg border border-slate-700">⌘K</kbd>
          <button
            type="submit"
            class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-xs transition-all shadow-glow flex items-center gap-1"
          >
            <span>搜索</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>
    </form>

    <!-- Specific Hot Pills as Requested -->
    <div class="flex items-center justify-center gap-2 sm:gap-2.5 mt-3.5 flex-wrap text-xs text-slate-400">
      <span class="inline-flex items-center gap-1 text-slate-400 font-semibold text-[11px]">
        <span>🔍 热门搜索：</span>
      </span>
      <a href="/category/cost-effective" class="px-2.5 py-1 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-tech-emerald hover:border-tech-emerald/40 transition-colors text-[11px]">
        性价比机场排行
      </a>
      <a href="/category/clash-recommend" class="px-2.5 py-1 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-tech-cyan hover:border-tech-cyan/40 transition-colors text-[11px]">
        Clash机场推荐
      </a>
      <a href="/category/airport-nodes" class="px-2.5 py-1 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-tech-emerald hover:border-tech-emerald/40 transition-colors text-[11px]">
        高速机场节点
      </a>
      <a href="/search?q=ChatGPT打不开怎么办" class="px-2.5 py-1 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-tech-violet hover:border-tech-violet/40 transition-colors text-[11px]">
        ChatGPT打不开怎么办
      </a>
      <a href="/provider/u1s1" class="px-2.5 py-1 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-tech-cyan hover:border-tech-cyan/40 transition-colors text-[11px]">
        u1s1机场测评
      </a>
    </div>
  </div>

  <!-- Database Credibility Metrics Bar -->
  <div class="relative z-10 max-w-5xl mx-auto w-full px-2">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-2xl bg-slate-900/80 border border-slate-800 backdrop-blur-xl shadow-xl">
      <div class="text-center p-2">
        <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300 font-mono">100+</div>
        <div class="text-xs text-slate-400 mt-1 font-medium">机场测评监测品牌</div>
      </div>
      <div class="text-center p-2 border-l border-slate-800/80">
        <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-300 font-mono">42 家</div>
        <div class="text-xs text-slate-400 mt-1 font-medium">收录机场与历史档案</div>
      </div>
      <div class="text-center p-2 sm:border-l border-slate-800/80">
        <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-purple-300 font-mono">500+</div>
        <div class="text-xs text-slate-400 mt-1 font-medium">全球专线机场节点</div>
      </div>
      <div class="text-center p-2 border-l border-slate-800/80">
        <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-300 font-mono">24/7</div>
        <div class="text-xs text-slate-400 mt-1 font-medium">节点可用与跑路监控</div>
      </div>
    </div>
  </div>
</section>
