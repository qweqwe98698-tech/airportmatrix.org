---
import Icon from '../common/Icon.astro';

const trends = [
  {
    category: '热门搜索趋势',
    keyword: 'ChatGPT 1020 报错',
    growth: '+92%',
    sub: 'OpenAI 风控升级原生 IP 需求激增',
    color: 'emerald',
    href: '/articles/chatgpt-access-blocked-solution',
  },
  {
    category: '热门客户端',
    keyword: 'Clash Verge Rev',
    growth: '+78%',
    sub: 'Mihomo 核心全协议与 TUN 模式首选',
    color: 'cyan',
    href: '/client/clash-verge',
  },
  {
    category: '热门协议百科',
    keyword: 'VLESS Reality',
    growth: '+65%',
    sub: '无特征伪装抗 GFW 阻断天花板',
    color: 'violet',
    href: '/protocol/vless',
  },
  {
    category: '热门需求场景',
    keyword: '全 IEPL 专线',
    growth: '+81%',
    sub: '9Gbps 单线程 400MB/s 峰值实测',
    color: 'amber',
    href: '/provider/guangsucloud',
  },
];
---

<section class="py-8">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <div class="w-2.5 h-2.5 rounded-full bg-tech-emerald animate-ping"></div>
      <h2 class="text-sm sm:text-base font-bold text-white uppercase tracking-wider flex items-center gap-2">
        <span>实时趋势 Intelligence Dashboard</span>
        <span class="text-[10px] font-mono font-normal text-slate-400 bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700">实时算法权重</span>
      </h2>
    </div>
    <span class="text-xs text-slate-500 font-mono hidden sm:inline">Updated: 2026-08-21</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {trends.map((item) => (
      <a
        href={item.href}
        class="glass-card-hover rounded-2xl p-5 border border-slate-800/80 flex flex-col justify-between group relative overflow-hidden"
      >
        <div class="flex items-center justify-between mb-3">
          <span class="text-[11px] font-medium text-slate-400">{item.category}</span>
          <span class="inline-flex items-center gap-0.5 text-xs font-mono font-bold text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded-full border border-emerald-500/30">
            <span>↑</span>
            <span>{item.growth}</span>
          </span>
        </div>

        <div class="space-y-1">
          <div class="text-base font-extrabold text-white group-hover:text-tech-cyan transition-colors">
            {item.keyword}
          </div>
          <p class="text-xs text-slate-400 line-clamp-1">{item.sub}</p>
        </div>

        <div class="pt-3 mt-3 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-500 group-hover:text-slate-300 transition-colors">
          <span>进入数据分析</span>
          <Icon name="arrow-right" class="w-3 h-3 text-slate-400 group-hover:text-tech-cyan transition-transform group-hover:translate-x-1" />
        </div>
      </a>
    ))}
  </div>
</section>
