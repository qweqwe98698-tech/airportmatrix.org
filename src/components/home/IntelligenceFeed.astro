---
import Icon from '../common/Icon.astro';
import { articlesData } from '@/data/articles.data';

const intelItems = [
  {
    category: '品牌实测报告',
    badge: 'FLAGSHIP REVIEW',
    title: '光速云 (GuangSuCloud) 2026 深度实测：IEPL 企业专线、9Gbps 测速与 ChatGPT 解锁全记录',
    desc: '基于真实 MiaoKO 9Gbps 单线程测速，香港专线 424MB/s 满速，FullCone UDP 与年付均摊 7.5元/月评测。',
    date: '2026-08-21',
    author: 'AirportMatrix 实验室',
    href: '/articles/guangsucloud-in-depth-review-2026',
  },
  {
    category: '客户端与内核',
    badge: 'MIHOMO CORE',
    title: 'Clash Verge Rev 完整使用配置与避坑指南 (从下载到 TUN 模式全面实战)',
    desc: '告别停更老旧客户端，系统化配置驱动级 TUN 虚拟网卡与 Fake-IP 防污染机制。',
    date: '2026-08-21',
    author: '网络架构组',
    href: '/articles/clash-verge-rev-complete-tutorial',
  },
  {
    category: 'AI 访问与风控破局',
    badge: 'AI ACCESS',
    title: 'ChatGPT 报错 1020 / Access Denied / 无法登录？2026 原生 IP 破局终极指南',
    desc: '深度剖析 OpenAI 与 Cloudflare 风控模型，提供原生住宅 IP 识别与浏览器防关联技巧。',
    date: '2026-08-21',
    author: 'AI 实验室',
    href: '/articles/chatgpt-access-blocked-solution',
  },
  {
    category: '网络故障诊断',
    badge: 'TROUBLESHOOTING',
    title: '节点全部超时 (Timeout) 与全红无法连接？深度排查与修复全指南',
    desc: '系统化诊断网络故障：从时间同步、本地端口占用、订阅失效到 GFW 拦截权威方案。',
    date: '2026-08-21',
    author: '运维专家组',
    href: '/articles/node-timeout-troubleshooting-guide',
  },
];
---

<section class="py-12 border-t border-slate-800/80">
  <div class="flex items-end justify-between mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-tech-emerald"></span>
        <span class="text-xs font-bold text-tech-emerald tracking-wider uppercase">Latest Intelligence</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">最新行业情报与深度实测</h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        拒绝空洞通稿与洗稿广告。每篇情报均包含真实数据图表、排错流程与实测结论。
      </p>
    </div>
    <a href="/articles" class="text-xs font-semibold text-tech-cyan hover:text-cyan-300 flex items-center gap-1">
      <span>查看全部情报与指南 ({articlesData.length})</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {intelItems.map((item) => (
      <a
        href={item.href}
        class="glass-card-hover rounded-2xl p-6 sm:p-7 border border-slate-800/80 flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-[11px] font-bold text-slate-400">{item.category}</span>
            <span class="text-[10px] font-mono font-bold bg-tech-emerald/10 text-tech-emerald px-2 py-0.5 rounded border border-tech-emerald/30">
              {item.badge}
            </span>
          </div>

          <h3 class="text-lg font-bold text-white group-hover:text-tech-cyan transition-colors mb-2 leading-snug">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6">
            {item.desc}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-500">
          <span>{item.author} · {item.date}</span>
          <span class="text-tech-emerald font-bold flex items-center gap-1 group-hover:underline">
            阅读全文
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
