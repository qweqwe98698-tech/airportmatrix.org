---
import Icon from '../common/Icon.astro';

const hubs = [
  {
    title: 'Clash 客户端中枢',
    icon: 'cpu',
    desc: '跨平台 Mihomo 内核、TUN 虚拟网卡接管、分流规则编写与 Fake-IP 防污染。',
    links: [
      { name: '官方安全下载与版本选型', url: '/client/clash-verge#download-and-installation' },
      { name: 'TUN 模式驱动级配置实战', url: '/articles/clash-verge-rev-complete-tutorial#tun-mode-deep-dive' },
      { name: '四步订阅导入与自动更新', url: '/articles/clash-verge-rev-complete-tutorial#subscription-import-step-by-step' },
      { name: '无法联网与系统代理修复', url: '/articles/clash-verge-rev-complete-tutorial#common-errors-and-fixes' },
    ],
  },
  {
    title: '海外 AI 场景专区',
    icon: 'bot',
    desc: '解决 ChatGPT 1020 报错、Claude 封控拦截、Gemini 地区限制与 Cursor 实时补全。',
    links: [
      { name: 'ChatGPT 报错 1020 破局方案', url: '/articles/chatgpt-access-blocked-solution' },
      { name: '原生住宅 IP 欺诈度自测', url: '/articles/chatgpt-access-blocked-solution#residential-vs-datacenter-ip' },
      { name: 'OpenAI 客户端独立分流策略', url: '/articles/chatgpt-access-blocked-solution#client-routing-rules-for-ai' },
      { name: '支持 AI 全绿解锁专线列表', url: '/ai' },
    ],
  },
  {
    title: '网络故障与诊断中心',
    icon: 'alert-triangle',
    desc: '系统化定位节点全红、全部 Timeout、DNS 污染、端口死锁与海缆故障。',
    links: [
      { name: '节点全部超时 30秒自检清单', url: '/articles/node-timeout-troubleshooting-guide#quick-diagnosis-checklist' },
      { name: '系统时间未同步与 TLS 校验', url: '/articles/node-timeout-troubleshooting-guide#root-cause-1-time-sync' },
      { name: '本地 7890 端口冲突解除', url: '/articles/node-timeout-troubleshooting-guide#root-cause-3-port-conflicts' },
      { name: '结构化诊断流程树 (Flowchart)', url: '/articles/node-timeout-troubleshooting-guide#systematic-diagnostic-flowchart' },
    ],
  },
];
---

<section class="py-12 border-t border-slate-800/80">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <span class="w-2 h-2 rounded-full bg-tech-violet"></span>
      <span class="text-xs font-bold text-violet-400 tracking-wider uppercase">Knowledge Hub</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white">专题知识中心</h2>
    <p class="text-xs sm:text-sm text-slate-400 mt-1">按主题体系化查阅从下载、安装、配置到故障诊断的全套手册。</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {hubs.map((hub) => (
      <div class="glass-card-hover rounded-2xl p-6 border border-slate-800/80 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-tech-cyan">
              <Icon name={hub.icon} class="w-5 h-5" />
            </div>
            <h3 class="text-lg font-bold text-white">{hub.title}</h3>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">{hub.desc}</p>

          <ul class="space-y-2 text-xs border-t border-slate-800/60 pt-4">
            {hub.links.map((link) => (
              <li>
                <a href={link.url} class="flex items-center justify-between text-slate-300 hover:text-tech-cyan py-1 group/item">
                  <span class="line-clamp-1">{link.name}</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5 opacity-0 -translate-x-1 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition-all text-tech-cyan flex-shrink-0" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
