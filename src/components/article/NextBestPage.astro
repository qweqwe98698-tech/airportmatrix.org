---
import Icon from '../common/Icon.astro';

interface Props {
  title?: string;
  desc?: string;
  nextPages: Array<{
    title: string;
    href: string;
    desc: string;
    type?: string;
  }>;
}

const {
  title = '下一步进阶与相关主题 (Topic Bridge)',
  desc = '根据您当前查阅的内容，系统智能推荐以下上下文关联知识与解决方案：',
  nextPages,
} = Astro.props;
---

<div class="my-10 p-6 rounded-2xl bg-slate-900/70 border border-slate-800 backdrop-blur-md">
  <div class="flex items-center gap-2 mb-2">
    <div class="p-1 rounded-md bg-violet-500/20 text-violet-400">
      <Icon name="layers" class="w-4 h-4" />
    </div>
    <h3 class="text-base font-bold text-slate-100">{title}</h3>
  </div>
  <p class="text-xs text-slate-400 mb-5">{desc}</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {nextPages.map((page) => (
      <a
        href={page.href}
        class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80 hover:border-tech-cyan/40 hover:bg-slate-850 transition-all group flex flex-col justify-between"
      >
        <div>
          {page.type && (
            <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-800 text-slate-400 mb-1.5 uppercase">
              {page.type}
            </span>
          )}
          <div class="text-sm font-semibold text-slate-200 group-hover:text-tech-cyan transition-colors flex items-center justify-between">
            <span>{page.title}</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-tech-cyan" />
          </div>
          <p class="text-xs text-slate-400 mt-1 line-clamp-2">{page.desc}</p>
        </div>
      </a>
    ))}
  </div>
</div>
