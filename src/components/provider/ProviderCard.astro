---
import type { Provider } from '@/data/providers.data';
import RiskBadge from './RiskBadge.astro';
import Icon from '../common/Icon.astro';

interface Props {
  provider: Provider;
  rank?: number;
}

const { provider, rank } = Astro.props;
---

<div class="glass-card-hover rounded-xl p-5 flex flex-col justify-between relative group border border-slate-800/80">
  {rank && (
    <div class="absolute -top-3 -left-2 w-7 h-7 rounded-lg bg-slate-900 border border-tech-emerald/40 text-tech-emerald font-mono font-bold text-xs flex items-center justify-center shadow-glow">
      #{rank}
    </div>
  )}

  <div>
    <!-- Card Header -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <a href={`/provider/${provider.slug}`} class="text-base font-bold text-slate-100 hover:text-tech-cyan transition-colors">
            {provider.name}
          </a>
          <span class="text-[11px] text-slate-400 font-mono">始于 {provider.establishedYear}</span>
        </div>
        <p class="text-xs text-slate-400 mt-1 line-clamp-1">{provider.tagline}</p>
      </div>

      <!-- Score Box -->
      <div class="text-right flex-shrink-0">
        <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-slate-900/90 border border-slate-700 text-tech-emerald font-mono font-bold text-sm">
          <span>{provider.score.overall.toFixed(1)}</span>
          <span class="text-[10px] text-slate-500 font-normal">/10</span>
        </div>
        <div class="text-[10px] text-slate-400 mt-0.5">综合评分</div>
      </div>
    </div>

    <!-- Tags & Routes -->
    <div class="flex flex-wrap items-center gap-1.5 mb-4">
      <RiskBadge level={provider.riskLevel} />
      {provider.routes.map((route) => (
        <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800/90 text-cyan-300 border border-cyan-500/20">
          {route.toUpperCase()} 专线
        </span>
      ))}
      {provider.protocols.slice(0, 2).map((proto) => (
        <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-900 text-slate-300 border border-slate-700">
          {proto.toUpperCase()}
        </span>
      ))}
    </div>

    <!-- Unlocks & Capability Grid -->
    <div class="grid grid-cols-2 gap-2 p-3 rounded-lg bg-slate-950/60 border border-slate-900 mb-4 text-xs">
      <div class="flex items-center gap-1.5">
        <Icon name="bot" class="w-3.5 h-3.5 text-emerald-400" />
        <span class="text-slate-400">AI 解锁:</span>
        <span class="font-medium text-slate-200">
          {provider.aiSupport.chatgpt ? '全绿通过' : '部分受限'}
        </span>
      </div>
      <div class="flex items-center gap-1.5">
        <Icon name="tv" class="w-3.5 h-3.5 text-cyan-400" />
        <span class="text-slate-400">流媒体:</span>
        <span class="font-medium text-slate-200">
          {provider.streamingSupport.netflix ? '4K/8K 解锁' : '基础支持'}
        </span>
      </div>
      <div class="flex items-center gap-1.5">
        <Icon name="server" class="w-3.5 h-3.5 text-violet-400" />
        <span class="text-slate-400">节点数:</span>
        <span class="font-medium text-slate-200">{provider.nodeCount}+</span>
      </div>
      <div class="flex items-center gap-1.5">
        <Icon name="shield-check" class="w-3.5 h-3.5 text-amber-400" />
        <span class="text-slate-400">稳定性:</span>
        <span class="font-medium text-slate-200">{provider.score.stability * 10}%</span>
      </div>
    </div>

    <!-- Pros Highlights -->
    <ul class="space-y-1 mb-4 text-[11px] text-slate-300">
      {provider.pros.slice(0, 2).map((pro) => (
        <li class="flex items-center gap-1.5">
          <span class="text-tech-emerald">✓</span>
          <span class="line-clamp-1">{pro}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Card Footer: Pricing & Action -->
  <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between gap-2">
    <div>
      <div class="text-[10px] text-slate-500">套餐起步</div>
      <div class="text-sm font-bold text-slate-100">
        <span class="text-xs text-tech-emerald font-mono font-normal">¥</span>
        <span class="text-base text-tech-emerald font-mono">{provider.pricing.minMonthly}</span>
        <span class="text-[10px] text-slate-400 font-normal">/{provider.pricing.billingPeriod.includes('月') ? '月' : '起'}</span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={`/provider/${provider.slug}`}
        class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors"
      >
        详细评测
      </a>
      <a
        href={provider.affiliateUrl}
        target="_blank"
        rel="nofollow sponsored noopener noreferrer"
        class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 transition-all flex items-center gap-1"
      >
        <span>直达官网</span>
        <Icon name="external-link" class="w-3 h-3" />
      </a>
    </div>
  </div>
</div>
