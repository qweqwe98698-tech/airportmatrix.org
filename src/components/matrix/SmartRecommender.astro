---
import Icon from '../common/Icon.astro';
import { providersData } from '@/data/providers.data';
---

<div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800 shadow-2xl relative overflow-hidden">
  <!-- Glowing background elements -->
  <div class="absolute -top-24 -right-24 w-60 h-60 bg-tech-emerald/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-60 h-60 bg-tech-cyan/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-2xl mx-auto text-center mb-8">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tech-emerald/10 border border-tech-emerald/30 text-tech-emerald text-xs font-semibold mb-3">
      <Icon name="sparkles" class="w-3.5 h-3.5" />
      <span>AI 驱动 · 智能需求匹配</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">30 秒获取您的专属机场方案</h2>
    <p class="text-xs sm:text-sm text-slate-400 mt-2">选择您的真实使用场景与核心偏好，算法将实时为您匹配最优专线与高可用服务商。</p>
  </div>

  <!-- Wizard Form -->
  <div id="recommender-wizard" class="max-w-2xl mx-auto space-y-6">
    <!-- Step 1: Scenario -->
    <div>
      <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2.5">
        步骤 1：您的核心主要用途是什么？
      </label>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="step-scenario">
        <button type="button" data-val="ai" class="rec-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-tech-cyan transition-all text-xs font-medium text-slate-200">
          <div class="text-base mb-1">🤖</div>
          <div class="font-bold text-slate-100">海外 AI 访问</div>
          <div class="text-[10px] text-slate-400">ChatGPT, Claude, Cursor</div>
        </button>
        <button type="button" data-val="streaming" class="rec-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-tech-cyan transition-all text-xs font-medium text-slate-200">
          <div class="text-base mb-1">🎬</div>
          <div class="font-bold text-slate-100">4K/8K 流媒体</div>
          <div class="text-[10px] text-slate-400">Netflix, YouTube, Disney+</div>
        </button>
        <button type="button" data-val="gaming" class="rec-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-tech-cyan transition-all text-xs font-medium text-slate-200">
          <div class="text-base mb-1">🎮</div>
          <div class="font-bold text-slate-100">外服游戏联机</div>
          <div class="text-[10px] text-slate-400">极低延迟、UDP 专线</div>
        </button>
        <button type="button" data-val="dev" class="rec-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-tech-cyan transition-all text-xs font-medium text-slate-200">
          <div class="text-base mb-1">💻</div>
          <div class="font-bold text-slate-100">开发与学术科研</div>
          <div class="text-[10px] text-slate-400">GitHub, Docker, 谷歌学术</div>
        </button>
        <button type="button" data-val="budget" class="rec-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-tech-cyan transition-all text-xs font-medium text-slate-200 col-span-2 sm:col-span-2">
          <div class="text-base mb-1">💰</div>
          <div class="font-bold text-slate-100">高性价比日常备用</div>
          <div class="text-[10px] text-slate-400">月付低价、大流量、基础顺畅</div>
        </button>
      </div>
    </div>

    <!-- Step 2: Budget -->
    <div>
      <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2.5">
        步骤 2：您的月度预算范围？
      </label>
      <div class="grid grid-cols-3 gap-2.5" id="step-budget">
        <button type="button" data-val="low" class="rec-budget-btn p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-center text-xs font-semibold text-slate-300 hover:border-tech-emerald">
          ¥10 ~ ¥25 / 月
        </button>
        <button type="button" data-val="mid" class="rec-budget-btn p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-center text-xs font-semibold text-slate-300 hover:border-tech-emerald">
          ¥25 ~ ¥60 / 月
        </button>
        <button type="button" data-val="high" class="rec-budget-btn p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-center text-xs font-semibold text-slate-300 hover:border-tech-emerald">
          ¥60+ (旗舰专线)
        </button>
      </div>
    </div>

    <!-- Dynamic High-Density Result Box -->
    <div id="rec-result" class="hidden p-6 rounded-2xl bg-slate-900/95 border border-tech-emerald/40 text-left animate-fadeIn shadow-2xl">
      <div id="rec-content" class="space-y-4">
        <!-- Rendered via JS -->
      </div>
    </div>
  </div>
</div>

<script define:vars={{ providers: providersData }}>
  let selectedScenario = 'ai';
  let selectedBudget = 'mid';

  function renderResult() {
    const resultBox = document.getElementById('rec-result');
    const contentBox = document.getElementById('rec-content');
    if (!resultBox || !contentBox) return;

    let matched = providers[0];

    if (selectedBudget === 'low') {
      matched = providers.find(p => p.slug === 'feimaocloud') || providers.find(p => p.slug === 'xingdaomeng') || matched;
    } else if (selectedScenario === 'streaming') {
      matched = providers.find(p => p.slug === 'lingmaonet') || providers.find(p => p.slug === 'yifanyun') || matched;
    } else if (selectedScenario === 'ai') {
      matched = providers.find(p => p.slug === 'guangsucloud') || providers.find(p => p.slug === 'sujie') || matched;
    }

    resultBox.classList.remove('hidden');

    contentBox.innerHTML = `
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold text-tech-emerald bg-emerald-950 px-2 py-0.5 rounded border border-emerald-500/30">算法匹配度 99%</span>
            <span class="text-xs text-amber-400">★★★★★</span>
            <span class="text-[11px] font-mono text-slate-400 bg-slate-800 px-1.5 py-0.5 rounded">${matched.establishedYear}年运营</span>
          </div>
          <h3 class="text-xl font-black text-white">${matched.name}</h3>
          <p class="text-xs text-slate-400 mt-0.5">${matched.tagline}</p>
        </div>
        <div class="text-left sm:text-right">
          <div class="text-xs text-slate-500">套餐起步</div>
          <div class="text-lg font-bold text-tech-emerald font-mono">¥${matched.pricing.minMonthly} / 月</div>
          <div class="text-[10px] text-slate-400 font-mono">(${matched.pricing.billingPeriod})</div>
        </div>
      </div>

      <!-- High-Density Database Entity Spec Table -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 py-2 text-xs">
        <div class="p-2 rounded-lg bg-slate-950 border border-slate-800/80">
          <span class="text-slate-500 text-[10px]">线路类型:</span>
          <div class="font-bold text-slate-200 uppercase font-mono">${matched.routes.join(' + ')}</div>
        </div>
        <div class="p-2 rounded-lg bg-slate-950 border border-slate-800/80">
          <span class="text-slate-500 text-[10px]">传输协议:</span>
          <div class="font-bold text-slate-200 uppercase font-mono">${matched.protocols.join(' / ')}</div>
        </div>
        <div class="p-2 rounded-lg bg-slate-950 border border-slate-800/80">
          <span class="text-slate-500 text-[10px]">兼容客户端:</span>
          <div class="font-bold text-slate-200">Clash / 小火箭 / sing-box</div>
        </div>
        <div class="p-2 rounded-lg bg-slate-950 border border-slate-800/80">
          <span class="text-slate-500 text-[10px]">AI支持 (ChatGPT):</span>
          <div class="font-bold text-emerald-400">✓ 原生解锁</div>
        </div>
        <div class="p-2 rounded-lg bg-slate-950 border border-slate-800/80">
          <span class="text-slate-500 text-[10px]">流媒体 (Netflix):</span>
          <div class="font-bold text-emerald-400">✓ 4K原生解锁</div>
        </div>
        <div class="p-2 rounded-lg bg-slate-950 border border-slate-800/80">
          <span class="text-slate-500 text-[10px]">风险监控评级:</span>
          <div class="font-bold text-emerald-400">🟢 低风险 · 正常</div>
        </div>
      </div>

      <!-- Entity Relationships -->
      <div class="space-y-2 text-xs py-2 border-t border-slate-800/80">
        <div class="flex items-center gap-2 flex-wrap text-slate-300">
          <span class="text-slate-400 font-bold">适合场景:</span>
          <span class="px-1.5 py-0.5 rounded bg-emerald-950/80 text-emerald-300 border border-emerald-500/20 text-[10px]">✓ ChatGPT/Claude</span>
          <span class="px-1.5 py-0.5 rounded bg-cyan-950/80 text-cyan-300 border border-cyan-500/20 text-[10px]">✓ Netflix 4K</span>
          <span class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 text-[10px]">✓ GitHub / 终端</span>
        </div>
        <div class="flex items-center gap-2 flex-wrap text-slate-300">
          <span class="text-slate-400 font-bold">关联知识:</span>
          <a href="${'/protocol/' + (matched.protocols[0] || 'vless')}" class="text-tech-cyan hover:underline text-[11px]">【${(matched.protocols[0] || 'vless').toUpperCase()} 协议原理】</a>
          <a href="/routes" class="text-tech-cyan hover:underline text-[11px]">【${matched.routes[0]?.toUpperCase()} 专线架构】</a>
          <a href="/client/clash-verge" class="text-tech-cyan hover:underline text-[11px]">【Clash Verge 教程】</a>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-800 flex items-center justify-between gap-3 flex-wrap">
        <div class="text-xs text-slate-400">
          ${matched.couponCode ? `专属优惠码: <strong class="text-tech-emerald font-mono bg-slate-950 px-2 py-0.5 rounded border border-slate-800">${matched.couponCode}</strong>` : ''}
        </div>
        <div class="flex items-center gap-2.5">
          <a href="${'/provider/' + matched.slug}" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors">
            查看实体档案与测速
          </a>
          <a href="${'/go/' + matched.slug}" target="_blank" rel="nofollow sponsored noopener noreferrer" class="px-5 py-2 rounded-xl text-xs font-bold bg-tech-emerald text-slate-950 hover:bg-emerald-400 transition-all shadow-glow flex items-center gap-1.5">
            <span>直达官网注册</span>
            <span>→</span>
          </a>
        </div>
      </div>
    `;
  }

  // Bind scenario buttons
  document.querySelectorAll('#step-scenario .rec-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#step-scenario .rec-btn').forEach(b => {
        b.classList.remove('border-tech-cyan', 'bg-slate-800');
        b.classList.add('bg-slate-900', 'border-slate-800');
      });
      btn.classList.remove('bg-slate-900', 'border-slate-800');
      btn.classList.add('border-tech-cyan', 'bg-slate-800');
      selectedScenario = btn.getAttribute('data-val') || 'ai';
      renderResult();
    });
  });

  // Bind budget buttons
  document.querySelectorAll('#step-budget .rec-budget-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#step-budget .rec-budget-btn').forEach(b => {
        b.classList.remove('border-tech-emerald', 'bg-slate-800');
        b.classList.add('bg-slate-900', 'border-slate-800');
      });
      btn.classList.remove('bg-slate-900', 'border-slate-800');
      btn.classList.add('border-tech-emerald', 'bg-slate-800');
      selectedBudget = btn.getAttribute('data-val') || 'mid';
      renderResult();
    });
  });

  // Auto trigger
  setTimeout(renderResult, 50);
</script>
