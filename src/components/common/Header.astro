---
import { siteConfig } from '@/data/site.config';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl transition-all">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 lg:gap-4">
    <!-- Brand Logo -->
    <div class="flex items-center gap-4 lg:gap-6 flex-shrink-0">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-tech-emerald to-tech-cyan p-0.5 shadow-glow transition-transform group-hover:scale-105">
          <div class="w-full h-full bg-slate-950 rounded-[6px] flex items-center justify-center">
            <span class="font-black text-transparent bg-clip-text bg-gradient-to-r from-tech-emerald to-tech-cyan text-xs font-mono tracking-tighter">AX</span>
          </div>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-slate-100 tracking-tight text-sm sm:text-base group-hover:text-white transition-colors">AirportMatrix</span>
            <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-tech-emerald/10 text-tech-emerald border border-tech-emerald/30 font-mono">X 5.0</span>
          </div>
          <span class="text-[10px] text-slate-400 font-medium tracking-wider hidden sm:block">机场矩阵 · 趋势数据</span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation (Strict whitespace-nowrap to prevent text wrapping) -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5 flex-shrink-0">
      {siteConfig.nav.map((item) => (
        <div class="relative group flex-shrink-0">
          <a
            href={item.href}
            class={`px-2.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors flex items-center gap-1 ${
              pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href))
                ? 'text-white bg-slate-800 border border-slate-700/80 shadow-sm'
                : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
            }`}
          >
            <span>{item.label}</span>
            {item.badge && (
              <span class={`text-[9px] px-1 py-0.2 rounded font-bold font-mono ${
                item.badge === 'LIVE'
                  ? 'bg-rose-500/20 text-rose-400 border border-rose-500/30 animate-pulse'
                  : item.badge === '5.0'
                  ? 'bg-tech-emerald/20 text-tech-emerald border border-tech-emerald/30'
                  : 'bg-tech-cyan/20 text-tech-cyan border border-tech-cyan/30'
              }`}>
                {item.badge}
              </span>
            )}
            {item.children && (
              <Icon name="chevron-down" class="w-3 h-3 text-slate-400 group-hover:text-slate-200 transition-transform group-hover:rotate-180" />
            )}
          </a>

          {/* Dropdown Menu */}
          {item.children && (
            <div class="absolute top-full left-0 mt-1 w-60 p-2 rounded-2xl bg-slate-900/95 backdrop-blur-2xl border border-slate-800 shadow-2xl opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-150 z-50">
              <div class="space-y-1">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block p-2 rounded-xl hover:bg-slate-800 transition-colors group/child"
                  >
                    <div class="text-xs font-bold text-slate-200 group-hover/child:text-tech-cyan transition-colors">{child.label}</div>
                    {child.desc && (
                      <div class="text-[10px] text-slate-400 line-clamp-1 mt-0.5">{child.desc}</div>
                    )}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0">
      <!-- Search Button Trigger -->
      <a
        href="/search"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-400 hover:text-slate-200 text-xs transition-colors whitespace-nowrap"
        title="按关键词搜索机场、客户端与故障"
      >
        <Icon name="search" class="w-3.5 h-3.5 text-slate-400" />
        <span class="hidden xl:inline text-xs">搜索...</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.2 text-[10px] font-mono bg-slate-800 text-slate-400 rounded border border-slate-700">⌘K</kbd>
      </a>

      <!-- Distinct Action CTA (Direct to Smart Recommender Wizard) -->
      <a
        href="/recommend/wizard"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-xs transition-all shadow-glow hover:shadow-glow-cyan whitespace-nowrap flex-shrink-0"
      >
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        <span>智能选型向导</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white"
        aria-label="Toggle Mobile Menu"
      >
        <Icon name="menu" class="w-5 h-5" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800/80 bg-slate-950 px-4 py-4 space-y-3">
    <div class="space-y-1">
      {siteConfig.nav.map((item) => (
        <div>
          <a
            href={item.href}
            class={`block px-3 py-2 rounded-lg text-xs font-semibold ${
              pathname === item.href ? 'text-tech-emerald bg-slate-900' : 'text-slate-300 hover:text-white'
            }`}
          >
            {item.label}
            {item.badge && <span class="ml-1 text-[9px] px-1 py-0.2 rounded bg-tech-cyan/20 text-tech-cyan">{item.badge}</span>}
          </a>
          {item.children && (
            <div class="pl-4 space-y-1 mt-1 border-l border-slate-800 ml-2">
              {item.children.map((child) => (
                <a href={child.href} class="block px-2 py-1 text-[11px] text-slate-400 hover:text-slate-200">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
