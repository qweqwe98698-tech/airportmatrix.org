---
import Icon from './Icon.astro';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const breadcrumbs = [{ name: '首页', url: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class="py-3 px-4 rounded-lg bg-slate-900/50 border border-slate-800/80 mb-6 text-xs flex items-center flex-wrap gap-1.5 text-slate-400">
  {breadcrumbs.map((crumb, idx) => (
    <div class="flex items-center gap-1.5">
      {idx > 0 && <span class="text-slate-600">/</span>}
      {idx === breadcrumbs.length - 1 ? (
        <span class="text-slate-200 font-medium truncate max-w-[240px] sm:max-w-md">{crumb.name}</span>
      ) : (
        <a href={crumb.url} class="hover:text-tech-cyan transition-colors">
          {crumb.name}
        </a>
      )}
    </div>
  ))}
</nav>
